# Machine-local inventory and credentials are never export inputs.
.local/
.venv/
.env
.env.*
!.env.example
*.age
*.pem
*.key
*.p12
*.pfx
*.tfstate
*.tfstate.*
.terraform/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
node_modules/
.cache/
dist/
artifacts/
# Never check in runtime browser, agent, or database state.
.vnc-chrome-profile/
.chrome-devtools-axi/
.omp/
.claude/
.codex/
.ssh/
# Private skills and rules stay on the host (blueprint/skills/private/README.md, blueprint/rules/private/README.md).
blueprint/skills/private/*
!blueprint/skills/private/README.md
blueprint/rules/private/*
!blueprint/rules/private/README.md
target/
pr-body.md
.lavish/
