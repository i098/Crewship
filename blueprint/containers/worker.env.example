# Compose environment example for the container profiles.
#
#   cp containers/worker.env.example .env      # `.env` is git-ignored
#
# Only non-secret knobs live here. Credentials never belong in this file:
# the PostgreSQL password is a Docker secret read from
# $HOME/.local/state/crewship/secrets/postgres_password (owner-only mode).
#
# Values mirror containers/crewship.container.yml. If you change CREWSHIP_USER,
# CREWSHIP_HOME or CREWSHIP_WORKSPACE you must change that document too, or the
# worker build fails its configuration-consistency guard.

# --- worker identity (must match containers/crewship.container.yml) -----------
CREWSHIP_USER=coder
CREWSHIP_UID=1000
CREWSHIP_GID=1000
CREWSHIP_HOME=/home/coder
CREWSHIP_WORKSPACE=/home/coder/Dev

# --- worker image and resource caps ------------------------------------------
CREWSHIP_TAG=dev
WORKER_CPUS=4
WORKER_MEMORY=6g
WORKER_MEMORY_RESERVATION=1g
WORKER_PIDS=4096
WORKER_SHM=512m

# --- optional example backing services (compose profile "data") --------------
# Ports are published on loopback only.
POSTGRES_USER=developer
POSTGRES_DB=developer
POSTGRES_PORT=15432
POSTGRES_CPUS=1
POSTGRES_MEMORY=1g
POSTGRES_PIDS=512

REDIS_PORT=16379
REDIS_MAXMEMORY=256mb
REDIS_CPUS=1
REDIS_MEMORY=512m
REDIS_PIDS=256
