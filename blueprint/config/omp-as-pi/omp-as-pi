#!/usr/bin/env bash
# omp-as-pi: lets no-mistakes drive omp through its native `pi` adapter, the
# only adapter that reuses one fixer session across review-fix rounds for an
# omp-family agent (acp:<target> always runs cold). omp is a Pi fork whose
# `--mode json` stream matches what the adapter parses (session header with a
# canonical UUID, message_update/message_end/turn_end/agent_end), so only two
# flag spellings differ:
#   --session <uuid>             -> --resume <uuid>
#   --no-context-files | -nc     -> the exact neutralization no-mistakes applies
#                                   to an omp gate (ompgate.go): --config
#                                   gate-overlay.yml --no-rules --no-skills
#                                   --no-extensions
# Wired by ~/.no-mistakes/config.yaml: agent: pi, agent_path_override.pi.
#
# Fail closed: any argument outside the set the v1.85.3 pi adapter emits is
# refused (exit 64) instead of guessed, the overlay is pinned by sha256, and the
# omp binary is re-checked for every flag this script relies on whenever it
# changes (Crewship upgrades omp to latest on every apply).
#   omp-as-pi --omp-as-pi-check   run the preflight only and report
set -euo pipefail

HERE=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
OVERLAY="$HERE/gate-overlay.yml"
OVERLAY_SHA256=1aaf4374d218ff78d776201cf6b1abd37c34854285a5bf3d6d5278dcd8e8e605
REQUIRED_FLAGS=(--mode --resume --no-session --model --thinking --provider --config --no-rules --no-skills --no-extensions)
CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/omp-as-pi/preflight-ok"

REFUSALS="${OMP_AS_PI_REFUSALS:-$HERE/refusals.log}"

# Keep refusal evidence even when the caller captures stderr.
die() {
	printf '%s %s\n' "$(date -Is)" "$*" >>"$REFUSALS" 2>/dev/null || true
	printf 'omp-as-pi: %s\n' "$*" >&2
	exit 64
}

is_uuid() {
	[[ $1 =~ ^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$ ]]
}

preflight() {
	OMP_BIN=$(command -v "${OMP_AS_PI_OMP:-omp}") || die "omp not found on PATH ($PATH)"
	local real ident help flag
	real=$(readlink -f "$OMP_BIN")
	ident="$real $(stat -c '%s %Y' "$real")"
	if [ -r "$CACHE" ] && [ "$(cat "$CACHE")" = "$ident" ]; then
		return 0
	fi
	help=$("$OMP_BIN" --help 2>&1) || die "'$OMP_BIN --help' failed"
	for flag in "${REQUIRED_FLAGS[@]}"; do
		grep -qE -- "(^|[[:space:],])${flag}([=[:space:],]|$)" <<<"$help" ||
			die "omp at $real no longer lists $flag in --help; update omp-as-pi before gates run on it"
	done
	mkdir -p "$(dirname "$CACHE")"
	printf '%s' "$ident" >"$CACHE.tmp" && mv "$CACHE.tmp" "$CACHE"
}

check_overlay() {
	[ -f "$OVERLAY" ] || die "gate overlay missing: $OVERLAY"
	[ "$(sha256sum "$OVERLAY" | cut -d' ' -f1)" = "$OVERLAY_SHA256" ] ||
		die "gate overlay $OVERLAY does not match its pinned sha256; refusing an unproven neutralization"
}

if [ "${1:-}" = --omp-as-pi-check ]; then
	rm -f "$CACHE"
	preflight
	check_overlay
	printf 'omp-as-pi: ok (omp %s, overlay pinned)\n' "$("$OMP_BIN" --version 2>/dev/null | head -n 1)"
	exit 0
fi

out=()
neutralize=0
mode=""
sessions=0
need_value() { [ "$2" -gt 0 ] || die "$1 needs a value"; }
while [ $# -gt 0 ]; do
	arg=$1
	shift
	case "$arg" in
	--no-context-files | -nc) neutralize=1 ;;
	--mode)
		need_value "$arg" $#
		mode=$1
		shift
		;;
	--no-session)
		sessions=$((sessions + 1))
		out+=(--no-session)
		;;
	--session)
		need_value "$arg" $#
		id=$1
		shift
		is_uuid "$id" || die "--session '$id' is not a canonical session UUID"
		sessions=$((sessions + 1))
		out+=(--resume "$id")
		;;
	--model | --thinking | --provider)
		need_value "$arg" $#
		out+=("$arg" "$1")
		shift
		;;
	*) die "refusing unrecognized argument '$arg': the no-mistakes pi adapter changed, so omp-as-pi must be updated before it can be trusted" ;;
	esac
done

[ "$mode" = json ] || die "expected '--mode json' from the pi adapter, got '${mode:-<none>}'"
[ "$sessions" -le 1 ] || die "conflicting session flags"

preflight
pre=()
if [ "$neutralize" = 1 ]; then
	check_overlay
	pre=(--config "$OVERLAY" --no-rules --no-skills --no-extensions)
fi

exec "$OMP_BIN" "${pre[@]}" "${out[@]}" --mode json
