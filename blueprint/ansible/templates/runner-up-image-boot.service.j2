{{ ansible_managed | comment }}
# Runs at boot, before the runner-up coordinators: builds a job image only when `docker image inspect` fails for it.
# A prune or a Docker reset can remove an image that no container uses (#1455).
[Unit]
Description=runner-up job image: build it again at boot when it is missing (Crewship managed)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
Environment=PATH={{ crewship_runner_up_shim_dir }}:%h/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=RUNNER_UP_SLICE={{ crewship_runner_up_slice }}
Environment=RUNNER_UP_IMAGE={{ crewship_runner_up_image }}
Environment=RUNNER_UP_DOCKERFILE={{ crewship_runner_up_dockerfile }}
{% if crewship_runner_up_dind | bool %}
Environment="RUNNER_UP_GUARD_PATH={{ crewship_runner_up_guard_path }}"
Environment=RUNNER_UP_DIND_DOCKERFILE={{ crewship_runner_up_dind_dockerfile }}
{% endif %}
ExecStart={{ crewship_runner_up_maintain }} image --ensure
TimeoutStartSec={{ crewship_runner_up_image_timeout }}
Nice=10
IOSchedulingClass=idle

[Install]
WantedBy=default.target
