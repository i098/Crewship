{{ ansible_managed | comment }}
# Nightly Forgejo backup (docs/forgejo.md#backups): one `forgejo dump` into
# {{ crewship_forgejo_dump_dir }}, then all but the newest {{ crewship_forgejo_dump_keep }} dumps are removed.
# A failed dump removes nothing.

[Unit]
Description=Forgejo nightly dump (Crewship managed)

[Service]
Type=oneshot
Environment=PATH=/usr/local/bin:/usr/bin:/bin
WorkingDirectory={{ crewship_forgejo_dump_dir }}
UMask=0077
ExecStart=/bin/sh -c '{{ crewship_forgejo_cli | join(" ") }} dump --quiet --type tar.zst --tempdir . --file "forgejo-dump-$(date -u +%%Y%%m%%dT%%H%%M%%SZ).tar.zst" && ls -1t forgejo-dump-*.tar.zst | tail -n +{{ crewship_forgejo_dump_keep + 1 }} | xargs -r rm -f --'
