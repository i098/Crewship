{{ ansible_managed | comment }}
# Herdr {{ crewship_herdr_version }} static configuration.
#
# Reviewed, non-secret subset only. Session state, pane history, saved machine
# catalogues and workspace state are deliberately not reproduced here.
# experimental.pane_history stays absent: it persists terminal output that can
# contain tokens.

onboarding = false

[theme]
name = "{{ crewship_cfg.herdr.theme }}"
auto_switch = {{ crewship_herdr_theme_auto_switch | bool | lower }}

[theme.custom]
sidebar_bg = "{{ crewship_cfg.herdr.sidebar_bg }}"

[ui]
sidebar_width = {{ crewship_cfg.herdr.sidebar_width | int }}
sidebar_max_width = {{ crewship_cfg.herdr.sidebar_max_width | int }}
show_agent_labels_on_pane_borders = {{ crewship_herdr_show_agent_labels | bool | lower }}
agent_panel_sort = "{{ crewship_cfg.herdr.agent_panel_sort }}"
# A distinct symbol per agent state instead of a colored dot.
status_indicators = "{{ crewship_herdr_status_indicators }}"

[ui.toast]
delivery = "{{ crewship_cfg.herdr.toast_delivery }}"

# Agent sidebar layout (docs/herdr.md). $who and the pull request parts come
# from the omp extension ~/.omp/agent/extensions/crewship-herdr-sidebar.ts.
[ui.sidebar.agents]
rows = {{ crewship_cfg.herdr.sidebar_agent_rows | trim }}

# Spaces sidebar layout (docs/herdr.md). Its $ tokens come from the
# herdr-spaces reporter timer.
[ui.sidebar.spaces]
rows = {{ crewship_cfg.herdr.sidebar_space_rows | trim }}

[update]
# Controls the updater's own check behaviour only. `./ship.sh launch` installs
# the latest release itself; never run `herdr update` from provisioning.
channel = "{{ crewship_herdr_update_channel }}"

[server]
headless_cols = {{ crewship_cfg.herdr.headless_cols | int }}
headless_rows = {{ crewship_cfg.herdr.headless_rows | int }}
