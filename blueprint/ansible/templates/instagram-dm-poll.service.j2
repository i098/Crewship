{{ ansible_managed | comment }}
# Triggered by instagram-dm-poll.timer; not enabled on its own.

[Unit]
Description=Poll the agent Instagram DMs (Crewship managed)
ConditionPathExists={{ crewship_instagram_dm_session }}

[Service]
Type=oneshot
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=FM_HOME={{ crewship_firstmate_dir }}
Environment=INSTAGRAM_DM_OPERATOR={{ crewship_instagram_dm_operator }}
Environment=INSTAGRAM_DM_SESSION={{ crewship_instagram_dm_session }}
Environment=INSTAGRAM_DM_DIR={{ crewship_instagram_dm_state }}
Environment=INSTAGRAM_DM_LOG={{ crewship_instagram_dm_log }}
Environment="INSTAGRAM_DM_NOTIFY={{ crewship_instagram_dm_notify }}"
Environment=INSTAGRAM_DM_INTERVAL={{ crewship_instagram_dm_interval }}
# Optional KEY=value lines: the limiter and timing settings of instagram_dm.py (docs/architecture.md#instagram-dm-alerts).
EnvironmentFile=-{{ crewship_instagram_dm_session | dirname }}/dm.env
ExecStart={{ crewship_uv_bin }} run --no-project --isolated --quiet --with instagrapi --with 'certifi>=2026.10.19' python {{ crewship_instagram_dm_script }} poll
