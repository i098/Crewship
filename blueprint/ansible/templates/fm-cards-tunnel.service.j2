{{ ansible_managed | comment }}
# Named Cloudflare tunnel for iMessage app cards (docs/imessage.md#cards). The tunnel is
# remotely managed: its one ingress rule maps {{ crewship_cfg.imessage.cards.url }} to the
# bridge's card-only port, 127.0.0.1:{{ crewship_imessage_card_port }}, and everything else to 404.
# The token is {{ crewship_imessage_card_tunnel_token_env }} in ~/super.env; it never goes on the command line.
# --config /dev/null keeps a named-tunnel config in ~/.cloudflared out of it.

[Unit]
Description=Cloudflare tunnel to the iMessage card pages (Crewship managed)
After=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/super.env
ExecStart=/bin/sh -c 'TUNNEL_TOKEN="$${{ crewship_imessage_card_tunnel_token_env }}" exec {{ crewship_local_bin }}/cloudflared tunnel --config /dev/null --no-autoupdate --metrics {{ crewship_imessage_card_metrics }} run'
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
