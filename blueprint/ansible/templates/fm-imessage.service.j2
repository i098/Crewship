{{ ansible_managed | comment }}
# Front of the iMessage bridge (docs/imessage.md#rolling-deploys). The bridge itself runs as fm-imessage@<slot>.service;
# this unit only starts the active slot at boot and stops the slots with it, so `is-active` still answers for the line.
# Upgrades go through imessage-deploy, never through a restart of this unit.

[Unit]
Description=iMessage bridge front, starts the active slot (Crewship managed)
After=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory={{ crewship_imessage_dir }}
Environment=PATH=%h/.local/bin:%h/.bun/bin:/usr/local/bin:/usr/bin:/bin
Environment="FM_IMESSAGE_DIR={{ crewship_imessage_dir }}"
StateDirectory=fm-imessage
StateDirectoryMode=0700
UMask=0077
ExecStart=/bin/sh -c 'exec "{{ crewship_local_bin }}/bun" "{{ crewship_local_bin }}/imessage-deploy.ts" boot'
ExecStop=/bin/sh -c 'exec "{{ crewship_local_bin }}/bun" "{{ crewship_local_bin }}/imessage-deploy.ts" stop-all'

[Install]
WantedBy=default.target
