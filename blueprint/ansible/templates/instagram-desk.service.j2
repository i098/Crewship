{{ ansible_managed | comment }}
# The Instagram front desk (docs/imessage.md#instagram-front-desk): it follows the listener's logs and answers a DM
# that main has left alone, through fm-insta-reply. It holds no Instagram credential.

[Unit]
Description=Instagram front desk (Crewship managed)
After=network-online.target

[Service]
WorkingDirectory={{ crewship_instagram_desk_dir }}
# omp (the front desk model) starts with "#!/usr/bin/env bun", and bun lives in ~/.local/bin; fm-insta-reply too.
Environment=PATH=%h/.local/bin:%h/.bun/bin:/usr/local/bin:/usr/bin:/bin
Environment="FM_HOME={{ crewship_firstmate_dir }}"
Environment=INSTAGRAM_DM_DIR={{ crewship_instagram_dm_state }}
Environment=INSTAGRAM_DM_LOG={{ crewship_instagram_dm_log }}
Environment="FM_INSTAGRAM_DESK_MODEL={{ crewship_instagram_desk_model }}"
Environment="FM_INSTAGRAM_DESK_OWNER_NAME={{ crewship_instagram_desk_owner_name }}"
Environment="FM_INSTAGRAM_DESK_SUPERVISOR_MODEL={{ crewship_instagram_desk_supervisor_model }}"
Environment=FM_INSTAGRAM_DESK_QUIET_MS={{ crewship_instagram_desk_quiet_ms }}
Environment=FM_INSTAGRAM_DESK_REEL_QUIET_MS={{ crewship_instagram_desk_reel_quiet_ms }}
# ~/.local/state/instagram-desk: the desk's memory, its log and its empty cwd.
StateDirectory=instagram-desk
StateDirectoryMode=0700
UMask=0077
ExecStart={{ crewship_local_bin }}/bun instagram-desk.ts
KillMode=mixed
TimeoutStopSec=10
Restart=always
RestartSec=15

[Install]
WantedBy=default.target
