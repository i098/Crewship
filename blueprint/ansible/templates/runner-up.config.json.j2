#jinja2: lstrip_blocks: True
{#- The runner-up setup, made from the CI pool's repository list (docs/runner-up.md#how-the-config-is-made).
    Each entry keeps its own places, so a named slot group keeps its own capacity, and each label that
    is not a reserved one becomes a pool that only that entry's places serve. The coordinator applies an edit
    of this file by itself, so a change here needs no restart. -#}
{% set total = crewship_runner_up_total_slots | int %}
{% set cpus = crewship_runner_up_job_cpus | int %}
{% set memory = crewship_runner_up_job_memory_gb | int * 1024 %}
{% set repos = [] %}
{% set pools = [] %}
{% set pool_labels = [] %}
{% set places = [] %}
{% for entry in crewship_runner_up_repos %}
{%   set slug = entry.name | default(entry.repo | lower | regex_replace('[^a-z0-9]+', '-') | regex_replace('^-|-$', ''), true) %}
{%   set entry_pools = [] %}
{%   if entry.repo not in repos %}{% set _ = repos.append(entry.repo) %}{% endif %}
{%   for label in entry.labels if label | lower not in crewship_runner_up_reserved_labels %}
{%     set _ = entry_pools.append(label) %}
{%     if label not in pool_labels %}{% set _ = pool_labels.append(label) %}{% set _ = pools.append({'label': label}) %}{% endif %}
{%   endfor %}
{%   for n in range(1, entry.slots + 1) %}
{%     set _ = places.append({'id': slug ~ '-' ~ n, 'provider': 'docker', 'pools': entry_pools,
                              'cores': cpus, 'memoryMB': memory, 'image': crewship_runner_up_image}) %}
{%   endfor %}
{% endfor %}
{% set machines = [{'name': 'local', 'cores': total * cpus, 'memoryMB': total * memory, 'places': places}] %}
{% for machine in crewship_runner_up.machines | default([]) %}
{%   set machine_places = [] %}
{%   for n in range(1, machine.slots | default(1) + 1) %}
{%     set _ = machine_places.append({'id': machine.name ~ '-' ~ n, 'provider': machine.provider | default('docker'),
                                      'pools': pool_labels, 'cores': machine.job_cpus | default(cpus),
                                      'memoryMB': machine.job_memory_gb | default(memory // 1024) * 1024}
                                     | combine({'image': machine.image} if machine.image is defined else {})) %}
{%   endfor %}
{%   set _ = machines.append({'name': machine.name, 'ssh': machine.ssh, 'cores': machine.cores,
                              'memoryMB': machine.memory_gb * 1024, 'places': machine_places}
                             | combine({'agent': machine.agent} if machine.agent is defined else {})) %}
{% endfor %}
{{ {'stateDir': crewship_runner_up_state_dir,
    'github': {'repos': repos},
    'pools': pools,
    'machines': machines,
    'logKeepDays': crewship_runner_up_log_keep_days | int} | to_nice_json }}
