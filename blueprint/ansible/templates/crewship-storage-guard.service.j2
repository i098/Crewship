{{ ansible_managed | comment }}
# Triggered by crewship-storage-guard.timer; not enabled on its own.
# Measures every mounted real block filesystem (not tmpfs, overlay, squashfs or
# loop devices) and the ones holding /, /var/log, the home and Docker's data root:
# alerts at WARN once per episode and early when the fill rate projects full,
# prunes only regenerable data at CRIT: gitignored build output in Treehouse
# pool worktrees untouched for WORKTREE_PRUNE_AGE_DAYS (worktree-prune.sh), then
# Docker build cache, dangling images and unused images created more than
# STORAGE_IMAGE_AGE_HOURS ago (creation time, not last use).

[Unit]
Description=Fleet storage guard - alert on disk use, prune regenerable worktree output and Docker data at CRIT (Crewship managed)
ConditionPathExists={{ crewship_fleet_doctor_dir }}/storage-guard.sh

[Service]
Type=oneshot
Environment=PATH=%h/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=FM_HOME={{ crewship_firstmate_dir }}
Environment="STORAGE_DATA_DIR={{ crewship_data_dir }}"
Environment=STORAGE_WARN_PCT={{ crewship_storage_guard_warn_pct }}
Environment=STORAGE_CRIT_PCT={{ crewship_storage_guard_crit_pct }}
Environment=STORAGE_HYSTERESIS_PCT={{ crewship_storage_guard_hysteresis_pct }}
Environment=STORAGE_IMAGE_AGE_HOURS={{ crewship_storage_guard_image_age_hours }}
Environment=STORAGE_FILL_HORIZON_HOURS={{ crewship_storage_guard_fill_horizon_hours }}
Environment=STORAGE_FILL_MIN_PCT={{ crewship_storage_guard_fill_min_pct }}
Environment=STORAGE_REPEAT_MIN={{ crewship_storage_guard_repeat_min }}
Environment=WORKTREE_PRUNE_AGE_DAYS={{ crewship_storage_guard_worktree_age_days }}
ExecStart={{ crewship_fleet_doctor_dir }}/storage-guard.sh
# One du walk per alerting filesystem (<= 300 s each), the worktree prune and
# three Docker prune steps (<= 300 s each) and the docker info / system df
# queries (<= 80 s): 3600 s covers seven alerting filesystems at once.
TimeoutStartSec=3600
Nice=5
IOSchedulingClass=best-effort
IOSchedulingPriority=7
