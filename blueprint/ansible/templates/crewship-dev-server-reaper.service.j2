{{ ansible_managed | comment }}
# Triggered by crewship-dev-server-reaper.timer; not enabled on its own.
# Kills `next dev`/`next-server`/`tsc --noEmit` in treehouse worktrees whose
# lane is done/paused/blocked/failed, agent-less, or idle >= 30 minutes.

[Unit]
Description=Fleet dev-server reaper - drop dev servers that outlived their lane (Crewship managed)
ConditionPathExists={{ crewship_fleet_doctor_dir }}/dev-server-reaper.sh

[Service]
Type=oneshot
Environment=PATH=%h/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart={{ crewship_fleet_doctor_dir }}/dev-server-reaper.sh
TimeoutStartSec=120
Nice=5
