{{ ansible_managed | comment }}
[Unit]
Description=Project database worktree environment (Crewship managed)
ConditionPathExists=%h/.local/state/code-factory/project-db/projects-dir

[Service]
Type=oneshot
Environment=PATH=%h/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart={{ crewship_local_bin }}/crewship-db --seed
TimeoutStartSec=300
