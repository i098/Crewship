#!/usr/bin/env bash
# fleet-browser - the fleet's browser ladder, one command.
#
#   tier 1  obscura   ws/http 127.0.0.1:9222   DEFAULT. Rust engine, ~25 MB idle,
#                     ~5x less RAM per page than Chrome, renders the app faithfully,
#                     CDP: clicks, screenshots, screencast. Always on.
#   tier 2  chrome    http 127.0.0.1:9522      FALLBACK for pixel-critical evidence
#                     (the maintainer inspects before/after shots) or a page
#                     Obscura misrenders. Headless Chromium, persistent profile.
#                     Started on demand, stopped after 30 min without a client.
#   tier 3  voxl      http 127.0.0.1:9523      LAST RESORT: a headed Chrome on an
#                     Xvfb display (:9) streamed by voxl on 127.0.0.1:6913, for when
#                     a human must see or drive the browser (OAuth consent, a
#                     captcha, a native dialog). A permanent service: it starts at
#                     boot once the cookie jar exists, gc never stops it, and its
#                     guard stops it if the jar count falls.
#
# One session across all three: cookie-sync.ts keeps a canonical jar in
# ~/.fleet-browser/cookies.json and converges every live tier to it (timer every
# 2 min, plus on every `up`). Log in once anywhere, be logged in everywhere,
# except Google: its cookies stay in the tier that set them (see cookie-sync.ts).
#
#   fleet-browser status            tiers, ports, clients, cookie counts
#   fleet-browser env [tier]        export lines for chrome-devtools-axi / omp (default: obscura)
#   fleet-browser up chrome|voxl    start a fallback tier, wait ready, push the session in
#   fleet-browser down chrome|voxl  stop a fallback tier (voxl is permanent; `up voxl` brings it back)
#   fleet-browser sync              converge cookies now
#   fleet-browser gc                stop idle chrome (>= $IDLE_MIN min; timer); voxl is never stopped
#   fleet-browser seed <profile>    one-shot: import cookies from a Chrome profile dir
set -u
HERE=$(cd "$(dirname "$0")" && pwd)
STATE=$HOME/.fleet-browser
LOG=$STATE/fleet-browser.log
IDLE_MIN=${FLEET_BROWSER_IDLE_MIN:-30}
BUN=${BUN:-bun}
OBSCURA_URL=http://127.0.0.1:9222
CHROME_URL=http://127.0.0.1:9522
VOXL_URL=http://127.0.0.1:9523
OBSCURA_JAR=$STATE/obscura/cookies.json
VOXL_DISPLAY=9
VOXL_WEB_PORT=${VOXL_WEB_PORT:-6913}
# The guard stops voxl when the shared jar falls more than this share between two consecutive checks.
VOXL_JAR_DROP_PCT=${VOXL_JAR_DROP_PCT:-5}
VOXL_GUARD_SECS=${VOXL_GUARD_SECS:-30}
VOXL_JAR_WAIT_SECS=${VOXL_JAR_WAIT_SECS:-120}
mkdir -p "$STATE"; chmod 755 "$STATE"
log() { printf '[%s] %s\n' "$(date -u +%FT%TZ)" "$*" >> "$LOG"; }

port_of() { case "$1" in obscura) echo 9222 ;; chrome) echo 9522 ;; voxl) echo 9523 ;; *) return 1 ;; esac; }
url_of() { case "$1" in obscura) echo "$OBSCURA_URL" ;; chrome) echo "$CHROME_URL" ;; voxl) echo "$VOXL_URL" ;; *) return 1 ;; esac; }
unit_of() { echo "fleet-browser-$1.service"; }
alive() { curl -s -m 3 -o /dev/null "$(url_of "$1")/json/version"; }
clients() { ss -Htn state established "( sport = :$(port_of "$1") )" 2>/dev/null | wc -l; }
# Obscura reads its session from the storage file (live: it flushes on every
# setCookies, so lane logins land there immediately) but must be WRITTEN over
# CDP - an external file write while it runs is clobbered on the next restart
# (measured 2026-09-17). cookie-sync.ts takes `cdp|file://path` to split the
# two paths. The restart-when-idle below keys off the file mtime, which a CDP
# write updates, so merged sessions reach the next lane connection.
tiers_arg() { echo "obscura=$OBSCURA_URL|file://$OBSCURA_JAR chrome=$CHROME_URL voxl=$VOXL_URL"; }

cmd_status() {
  printf '%-8s %-6s %-9s %-8s %s\n' TIER PORT STATE CLIENTS NOTE
  for t in obscura chrome voxl; do
    st=down; alive "$t" && st=up
    note=
    [ "$t" = obscura ] && note="default"
    [ "$t" = chrome ] && note="fallback: pixel-critical evidence (fleet-browser up chrome)"
    [ "$t" = voxl ] && note="last resort: human eyes/hands; voxl http://127.0.0.1:$VOXL_WEB_PORT/ (fleet-browser up voxl)"
    if [ "$t" = chrome ] && [ "$st" = up ]; then
      idle=$(idle_minutes "$t"); note="$note; idle ${idle}m of ${IDLE_MIN}m"
    fi
    printf '%-8s %-6s %-9s %-8s %s\n' "$t" "$(port_of "$t")" "$st" "$(clients "$t")" "$note"
  done
  n=$(jar_count); n=${n:-0}
  echo "session: $n cookies in canonical jar ($STATE/cookies.json); last sync: $(tail -1 "$STATE/sync.log" 2>/dev/null | cut -c1-120)"
}

cmd_env() {
  local t=${1:-obscura}
  url_of "$t" >/dev/null || { echo "unknown tier $t" >&2; exit 2; }
  if ! alive "$t"; then
    case "$t" in obscura) echo "# obscura is DOWN: systemctl --user start fleet-browser-obscura.service" >&2 ;; *) echo "# $t is not running: fleet-browser up $t" >&2 ;; esac
  fi
  cat <<EOF
# fleet browser tier: $t  (ladder: obscura -> chrome -> voxl; see ~/oss-fleet/browsers/README.md)
export CHROME_DEVTOOLS_AXI_BROWSER_URL=$(url_of "$t")
export FLEET_BROWSER_TIER=$t
EOF
  [ "$t" = obscura ] || echo "export CHROME_DEVTOOLS_AXI_SESSION=\${CHROME_DEVTOOLS_AXI_SESSION:-\$(basename \"\$PWD\")-$t}   # separate bridge from the default tier"
}

wait_alive() {  # <tier> <seconds>
  local i; for i in $(seq 1 "$2"); do alive "$1" && return 0; sleep 1; done; return 1
}

# The voxl login. The tailnet URL is plain HTTP behind `tailscale serve`, so voxl
# keeps its own password; it is made once and survives restarts.
voxl_password() {
  local f=$STATE/voxl-password
  [ -s "$f" ] || (umask 077; head -c 24 /dev/urandom | base64 | tr -d '/+=\n' > "$f")
  cat "$f"
}

voxl_serve() {  # voxl on loopback only, password from $VOXL_PASSWORD; .ts.net names pass voxl's host check
  exec "$1" --addr=127.0.0.1 --port="$2" --allowed-hosts=.ts.net --audio-enabled=false --title="Fleet browser"
}

cmd_up() {
  local t=$1
  case "$t" in chrome|voxl) ;; obscura) systemctl --user start "$(unit_of obscura)"; wait_alive obscura 20 && echo "obscura up" || { echo "obscura failed to start" >&2; exit 1; }; return ;; *) echo "usage: fleet-browser up chrome|voxl" >&2; exit 2 ;; esac
  if alive "$t"; then echo "$t already up"; else
    systemctl --user start "$(unit_of "$t")" || { echo "systemctl start $(unit_of "$t") failed" >&2; exit 1; }
    wait_alive "$t" 60 || { echo "$t did not answer on $(url_of "$t") within 60s; journalctl --user -u $(unit_of "$t")" >&2; exit 1; }
    log "up $t"
  fi
  date +%s > "$STATE/last-client-$t"
  cmd_sync
  echo "$t up at $(url_of "$t")"; [ "$t" = voxl ] && echo "view: http://127.0.0.1:$VOXL_WEB_PORT/  (password: $STATE/voxl-password; tunnel: ssh -L $VOXL_WEB_PORT:127.0.0.1:$VOXL_WEB_PORT box)"
  echo "use:  eval \"\$(fleet-browser env $t)\""
}

cmd_down() {
  local t=$1
  case "$t" in chrome|voxl) ;; *) echo "usage: fleet-browser down chrome|voxl" >&2; exit 2 ;; esac
  alive "$t" && cmd_sync
  systemctl --user stop "$(unit_of "$t")" && log "down $t" && echo "$t stopped"
}

cmd_sync() {
  local out rc
  out=$("$BUN" "$HERE/cookie-sync.ts" --state "$STATE" $(tiers_arg) 2>&1); rc=$?
  # Exit 3: obscura holds cookies to delete (a replayed Google copy), which it
  # ignores over CDP. Sync again with it stopped so its file is rewritten, then
  # start it on that file. Only when no lane is connected; else next tick.
  if [ "$rc" -eq 3 ] && [ "$(clients obscura)" -eq 0 ]; then
    systemctl --user stop "$(unit_of obscura)"
    out="$out; $("$BUN" "$HERE/cookie-sync.ts" --state "$STATE" $(tiers_arg) 2>&1)"
    systemctl --user start "$(unit_of obscura)" && wait_alive obscura 20 && log "obscura restarted to drop cookies it ignores over CDP"
  fi
  printf '[%s] %s\n' "$(date -u +%FT%TZ)" "$out" >> "$STATE/sync.log"
  echo "$out"
  refresh_obscura_if_idle
}

# Obscura hands every new connection the jar it loaded at START. After the
# file changed, a restart is what makes the merged session reach new lanes; it
# is done only when no lane is connected (an open CDP connection is a lane at
# work) and takes ~1 s. With lanes connected it waits for the next tick.
refresh_obscura_if_idle() {
  alive obscura || return 0
  local started file_m
  started=$(date -d "$(systemctl --user show fleet-browser-obscura.service -p ActiveEnterTimestamp --value)" +%s 2>/dev/null) || return 0
  file_m=$(stat -c %Y "$OBSCURA_JAR" 2>/dev/null) || return 0
  [ "$file_m" -gt "$started" ] || return 0
  if [ "$(clients obscura)" -eq 0 ]; then
    systemctl --user restart fleet-browser-obscura.service && log "obscura restarted to load merged session" && echo "obscura reloaded session (no lanes connected)"
  else
    echo "obscura session file newer than process; reload deferred ($(clients obscura) lane(s) connected)"
  fi
}

# Minutes since a fallback tier last had a CDP client. Any established
# connection resets the clock; the timestamp survives between gc ticks.
idle_minutes() {  # <tier>
  local f=$STATE/last-client-$1 now; now=$(date +%s)
  if [ "$(clients "$1")" -gt 0 ]; then echo "$now" > "$f"; echo 0; return; fi
  [ -f "$f" ] || echo "$now" > "$f"
  echo $(( (now - $(cat "$f")) / 60 ))
}

cmd_gc() {
  for t in chrome; do
    alive "$t" || continue
    idle=$(idle_minutes "$t")
    if [ "$idle" -ge "$IDLE_MIN" ]; then
      cmd_sync >/dev/null
      systemctl --user stop "$(unit_of "$t")" && log "gc: stopped $t after ${idle}m idle" && echo "stopped $t (idle ${idle}m)"
    fi
  done
}

# Import cookies from an existing Chrome profile directory (one-shot): a
# throwaway headless Chrome opens the profile on a private port, cookie-sync
# reads it as an extra source, then the Chrome exits. Refuses a profile that
# another Chrome has open (SingletonLock) - never two Chromes on one profile.
cmd_seed() {
  local prof=$1 chrome
  [ -d "$prof" ] || { echo "no such profile dir: $prof" >&2; exit 2; }
  if [ -e "$prof/SingletonLock" ] && fuser "$prof/SingletonLock" >/dev/null 2>&1; then echo "profile $prof is open in another Chrome; close it first" >&2; exit 1; fi
  chrome=$(fleet_chrome_bin) || { echo "no chrome binary" >&2; exit 1; }
  "$chrome" --headless=new --no-sandbox --disable-gpu --no-first-run --remote-debugging-port=9229 --user-data-dir="$prof" about:blank >/dev/null 2>&1 &
  local pid=$!
  local i; for i in $(seq 1 30); do curl -s -m 2 -o /dev/null http://127.0.0.1:9229/json/version && break; sleep 1; done
  "$BUN" "$HERE/cookie-sync.ts" --state "$STATE" --seed http://127.0.0.1:9229 $(tiers_arg) | tee -a "$STATE/sync.log"
  kill "$pid" 2>/dev/null; wait "$pid" 2>/dev/null
  rm -f "$prof"/Singleton* 2>/dev/null
  log "seeded from $prof"
}

fleet_chrome_bin() {
  local c
  for c in "${FLEET_CHROME_BIN:-}" /usr/bin/google-chrome /usr/bin/google-chrome-stable /usr/bin/chromium /usr/bin/chromium-browser; do
    [ -n "$c" ] && [ -x "$c" ] && { echo "$c"; return 0; }
  done
  c=$(ls -d "$HOME"/.cache/ms-playwright/chromium-*/chrome-linux64/chrome 2>/dev/null | sort -V | tail -1)
  [ -n "$c" ] && [ -x "$c" ] && { echo "$c"; return 0; }
  return 1
}

# --- unit entrypoints (ExecStart targets; keep the unit files declarative) ---
run_chrome() {  # tier 2
  local chrome; chrome=$(fleet_chrome_bin) || { echo "no chrome binary"; exit 1; }
  mkdir -p "$STATE/chrome-profile"
  exec "$chrome" --headless=new --no-sandbox --disable-gpu --disable-dev-shm-usage --no-first-run --no-default-browser-check \
    --remote-debugging-port=9522 --remote-allow-origins='*' --user-data-dir="$STATE/chrome-profile" \
    --window-size=1280,800 about:blank
}

# A missing jar counts as 0; a jar that cannot be read right now (mid-write) prints nothing.
jar_count() { [ -e "$STATE/cookies.json" ] || { echo 0; return; }; python3 -c "import json,sys;print(len(json.load(open(sys.argv[1]))))" "$STATE/cookies.json" 2>/dev/null; }

# Voxl starts only once the shared jar exists, so it never joins the cookie sync with nothing to give.
wait_jar() {
  local i; for i in $(seq 1 "$VOXL_JAR_WAIT_SECS"); do [ -s "$STATE/cookies.json" ] && return 0; sleep 1; done
  echo "no cookie jar at $STATE/cookies.json after ${VOXL_JAR_WAIT_SECS}s" >&2; return 1
}

# Refuse to keep running while the shared jar loses cookies: a headed browser that joins the
# sync with fewer logins can drag the canonical jar down. Log the drop and stop the unit.
voxl_guard() {
  local prev now; prev=$(jar_count); prev=${prev:-0}
  while sleep "$VOXL_GUARD_SECS"; do
    now=$(jar_count); [ -n "$now" ] || continue
    if [ "$now" -lt $(( prev - prev * VOXL_JAR_DROP_PCT / 100 )) ]; then
      log "voxl guard: shared jar fell from $prev to $now cookies; stopping voxl"
      systemctl --user stop "$(unit_of voxl)"; return
    fi
    prev=$now
  done
}

run_voxl() {  # tier 3: Xvfb display + window manager + voxl + headed Chromium; foreground on the Chrome pid
  local chrome; chrome=$(fleet_chrome_bin) || { echo "no chrome binary"; exit 1; }
  local voxl=$HERE/voxl
  [ -x "$voxl" ] || { echo "$voxl not installed (tier 3 unavailable)"; exit 1; }
  command -v Xvfb >/dev/null || { echo "Xvfb not installed (tier 3 unavailable)"; exit 1; }
  # The profile keeps its old name: the tier's logins live in it.
  mkdir -p "$STATE/vnc-profile"
  # The unit's control group owns Xvfb, the window manager and voxl, so stopping
  # the unit stops them with Chrome.
  if [ ! -e "/tmp/.X11-unix/X$VOXL_DISPLAY" ]; then
    Xvfb ":$VOXL_DISPLAY" -screen 0 1600x900x24 -shmem -nolisten tcp >"$STATE/xvfb.log" 2>&1 &
    local i; for i in $(seq 1 20); do [ -e "/tmp/.X11-unix/X$VOXL_DISPLAY" ] && break; sleep 0.5; done
    [ -e "/tmp/.X11-unix/X$VOXL_DISPLAY" ] || { echo "display :$VOXL_DISPLAY never came up"; exit 1; }
  fi
  export DISPLAY=":$VOXL_DISPLAY"
  command -v xfwm4 >/dev/null 2>&1 && { xfwm4 --replace >/dev/null 2>&1 & }
  # voxl on loopback only; a human reaches it with an ssh tunnel or `tailscale
  # serve`, whose tailnet listener on the same port must not count. Its login
  # password is the one voxl_password prints; .ts.net names are allowed so the
  # tailnet URL passes voxl's host check.
  if ! ss -ltn 2>/dev/null | grep -q "127.0.0.1:$VOXL_WEB_PORT "; then
    VOXL_PASSWORD=$(voxl_password) voxl_serve "$voxl" "$VOXL_WEB_PORT" >"$STATE/voxl.log" 2>&1 &
    local j; for j in $(seq 1 20); do ss -ltn 2>/dev/null | grep -q "127.0.0.1:$VOXL_WEB_PORT " && break; sleep 0.5; done
  fi
  voxl_guard &
  exec "$chrome" --no-sandbox --no-first-run --no-default-browser-check --start-maximized \
    --remote-debugging-port=9523 --remote-allow-origins='*' --user-data-dir="$STATE/vnc-profile" about:blank
}

case "${1:-status}" in
  status) cmd_status ;;
  env) cmd_env "${2:-obscura}" ;;
  up) cmd_up "${2:-}" ;;
  down) cmd_down "${2:-}" ;;
  sync) cmd_sync ;;
  gc) cmd_gc ;;
  seed) cmd_seed "${2:-}" ;;
  _run-chrome) run_chrome ;;
  _run-voxl) run_voxl ;;
  _wait-jar) wait_jar ;;
  _voxl-guard) voxl_guard ;;
  _voxl-serve) voxl_serve "${2:?voxl binary}" "${3:?port}" ;;
  -h|--help|help) sed -n '2,29p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) echo "unknown command: $1 (try: fleet-browser help)" >&2; exit 2 ;;
esac
