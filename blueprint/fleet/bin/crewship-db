#!/usr/bin/env python3
"""Per-project dev databases: <project> [checkout] prints an env file path; --seed converges all projects.

Each project gets one container of the engine its own compose file declares
(postgres, mysql, mariadb or redis), shared by all of its worktrees.
--seed starts the containers and writes DATABASE_URL or REDIS_URL into worktree .env.local files.
--check-docker verifies target-account access; --apply [--check] records the projects directory.
"""

import fcntl
import json
import os
import re
import secrets
import socket
import subprocess
import sys
import tempfile
from pathlib import Path

HOME = Path.home()
STATE = HOME / ".local/state/code-factory/project-db"
SECRETS = HOME / ".local/state/code-factory/secrets/project-db"
PROJECTS = STATE / "projects-dir"
FIRST_PORT = 25432
MARK = "# crewship-project-db"
LEGACY_MARK = "# crewship-shared-postgres"
NAME = re.compile(r"[A-Za-z][A-Za-z0-9_-]{0,47}")
COMPOSE_FILES = ("compose.yaml", "compose.yml", "docker-compose.yaml", "docker-compose.yml")
IMAGE = re.compile(r"^\s*image:\s*[\"']?([^\s\"'#]+)", re.M)
PASSWORD_FILE = "/run/secrets/db_password"
MYSQL_PING = (f'MYSQL_PWD="$(cat {PASSWORD_FILE})" $(command -v mariadb-admin || command -v mysqladmin) '
              'ping -h 127.0.0.1 -uroot --silent')

# One row per engine, in priority order when a compose file declares several.
# images lists the only repositories that engine accepts: the official image, unnamespaced
# (docker.io/ and library/ prefixes are ignored), plus pgvector/pgvector for postgres.
# ponytail: official image conventions only; any other namespace is rejected, add a row for another engine.
ENGINES = {
    "postgres": {
        "images": ("postgres", "pgvector/pgvector"), "default": "postgres:latest", "port": 5432,
        "data": "/var/lib/postgresql/data", "scheme": "postgresql", "var": "DATABASE_URL",
        "environment": {"POSTGRES_USER": "app", "POSTGRES_DB": "app", "PGDATA": "/var/lib/postgresql/data/pgdata",
                        "POSTGRES_PASSWORD_FILE": PASSWORD_FILE, "POSTGRES_INITDB_ARGS": "--data-checksums"},
        "health": ["CMD", "pg_isready", "-h", "127.0.0.1", "-U", "app", "-d", "app"],
    },
    "mysql": {
        "images": ("mysql",), "default": "mysql:lts", "port": 3306, "data": "/var/lib/mysql",
        "scheme": "mysql", "var": "DATABASE_URL",
        "environment": {"MYSQL_USER": "app", "MYSQL_DATABASE": "app", "MYSQL_PASSWORD_FILE": PASSWORD_FILE,
                        "MYSQL_ROOT_PASSWORD_FILE": PASSWORD_FILE},
        "health": ["CMD-SHELL", MYSQL_PING.replace("$", "$$")],
    },
    "mariadb": {
        "images": ("mariadb",), "default": "mariadb:lts", "port": 3306, "data": "/var/lib/mysql",
        "scheme": "mysql", "var": "DATABASE_URL",
        "environment": {"MYSQL_USER": "app", "MYSQL_DATABASE": "app", "MYSQL_PASSWORD_FILE": PASSWORD_FILE,
                        "MYSQL_ROOT_PASSWORD_FILE": PASSWORD_FILE},
        "health": ["CMD-SHELL", MYSQL_PING.replace("$", "$$")],
    },
    "redis": {
        "images": ("redis",), "default": "redis:latest", "port": 6379, "data": "/data",
        "scheme": "redis", "var": "REDIS_URL", "environment": {},
        "command": ["sh", "-c", ('umask 077; echo "requirepass $(cat ' + PASSWORD_FILE + ')" > /tmp/redis.conf; '
                                 'exec redis-server /tmp/redis.conf --appendonly yes').replace("$", "$$")],
        "health": ["CMD-SHELL", f'REDISCLI_AUTH="$$(cat {PASSWORD_FILE})" redis-cli -h 127.0.0.1 ping | grep -q PONG'],
    },
}


def docker(*args, optional=False):
    prefix = ["docker"] if os.access("/var/run/docker.sock", os.W_OK) else ["sudo", "-n", "docker"]
    result = subprocess.run([*prefix, *args], capture_output=True, text=True)
    if result.returncode and not optional:
        # Docker output can include passwords. Never forward it.
        raise RuntimeError("Docker operation failed; check the project database service")
    return result


def write_changed(path, text):
    if path.exists() and path.read_text() == text and path.stat().st_mode & 0o777 == 0o600:
        return False
    temporary = None
    try:
        with tempfile.NamedTemporaryFile("w", dir=path.parent, delete=False) as file:
            temporary = Path(file.name)
            file.write(text)
        temporary.replace(path)
    finally:
        if temporary is not None:
            temporary.unlink(missing_ok=True)
    return True


def password(path):
    if not path.exists():
        write_changed(path, secrets.token_hex(24) + "\n")
    path.chmod(0o600)
    value = path.read_text().strip()
    if not re.fullmatch(r"[a-f0-9]{48}", value):
        raise RuntimeError("Invalid stored database password")
    return value


def checkouts():
    """Map project name -> sorted checkout directories (every worktree of that project)."""
    found = {
        git.parent for pattern in ("*/*/*/.git", "firstmate-*/*/firstmate/projects/*/.git")
        for git in (HOME / ".treehouse").glob(pattern)
    }
    if PROJECTS.exists():
        found.update(git.parent for git in Path(PROJECTS.read_text().strip()).glob("*/.git"))
    projects = {}
    for directory in sorted(found):
        if NAME.fullmatch(directory.name):
            projects.setdefault(directory.name, []).append(directory)
    return projects


def repository(image):
    """Image name without registry prefix docker.io/ or library/, tag and digest."""
    name = image.split("@")[0]
    head, _, last = name.rpartition("/")
    name = f"{head}/{last.split(':')[0]}" if head else last.split(":")[0]
    return re.sub(r"^(?:docker\.io/)?(?:library/)?", "", name)


def detect(directories):
    """Return (engine, image) from the first compose file that names a supported engine, else None."""
    accepted = {name for spec in ENGINES.values() for name in spec["images"]}
    lookalikes = {name.rsplit("/", 1)[-1] for name in accepted} | {"postgis", "postgresql"}
    for directory in directories:
        for name in COMPOSE_FILES:
            try:
                images = IMAGE.findall((directory / name).read_text())
            except OSError:
                continue
            for image in images:
                repo = repository(image)
                if repo not in accepted and repo.rsplit("/", 1)[-1] in lookalikes:
                    print(f"crewship-db: unsupported image {image}: only official database images "
                          "(postgres, mysql, mariadb, redis, pgvector/pgvector) are supported", file=sys.stderr)
            for engine, spec in ENGINES.items():
                for image in images:
                    if repository(image) in spec["images"]:
                        # An image with an unresolved ${VAR} falls back to the engine default.
                        return engine, spec["default"] if "$" in image else image
    return None


def free_port(taken):
    port = FIRST_PORT
    while True:
        with socket.socket() as probe:
            if port not in taken and probe.connect_ex(("127.0.0.1", port)) != 0:
                return port
        port += 1


def compose_document(key, meta):
    spec = ENGINES[meta["engine"]]
    service = {
        "image": meta["image"],
        "container_name": "crewship-db-" + key,
        "restart": "unless-stopped",
        "environment": spec["environment"],
        "secrets": ["db_password"],
        "ports": [f"127.0.0.1:{meta['port']}:{spec['port']}"],
        "volumes": [f"data:{spec['data']}"],
        "healthcheck": {"test": spec["health"], "interval": "2s", "timeout": "5s", "retries": 60},
    }
    if "command" in spec:
        service["command"] = spec["command"]
    return {
        "name": "crewship-db-" + key,
        "services": {"db": service},
        "volumes": {"data": {"name": f"crewship-db-{key}-data"}},
        "secrets": {"db_password": {"file": str(SECRETS / (key + ".password"))}},
    }


def project_url(project, directories):
    """Converge the project's container and return (variable, url), or None without a supported engine."""
    key = project.lower()
    directory = STATE / key
    meta_file = directory / "meta.json"
    if meta_file.exists():
        meta = json.loads(meta_file.read_text())
    else:
        detected = detect(directories)
        if detected is None:
            return None
        taken = {json.loads(path.read_text())["port"] for path in STATE.glob("*/meta.json")}
        meta = {"engine": detected[0], "image": detected[1], "port": free_port(taken)}
    for private in (STATE, SECRETS, directory):
        private.mkdir(exist_ok=True, mode=0o700, parents=True)
    secret = password(SECRETS / (key + ".password"))
    write_changed(meta_file, json.dumps(meta, indent=2) + "\n")
    compose = directory / "compose.json"
    write_changed(compose, json.dumps(compose_document(key, meta), indent=2) + "\n")
    docker("compose", "-f", str(compose), "up", "-d", "--wait")
    spec = ENGINES[meta["engine"]]
    user = "" if meta["engine"] == "redis" else "app"
    path = "/0" if meta["engine"] == "redis" else "/app"
    return spec["var"], f"{spec['scheme']}://{user}:{secret}@127.0.0.1:{meta['port']}{path}"


def seed_worktree(worktree, variable, url):
    path = worktree / ".env.local"
    original = path.read_text() if path.exists() else ""
    lines = [line for line in original.splitlines()
             if line not in (MARK, LEGACY_MARK) and not re.match(rf"^\s*(?:export\s+)?{variable}\s*=", line)]
    write_changed(path, "\n".join([*lines, MARK, f"{variable}={url}"]) + "\n")


def seed():
    failure = None
    for project, directories in checkouts().items():
        try:
            result = project_url(project, directories)
        except RuntimeError as error:
            failure = failure or error  # one failing project must not block the others
            continue
        for worktree in directories if result else ():
            try:
                seed_worktree(worktree, *result)
            except OSError:
                continue  # a checkout removed during the scan
    if failure:
        raise failure


def apply(check=False):
    projects = str(Path(os.environ.get("CREWSHIP_PROJECTS_DIR", HOME / "Dev/firstmate/projects"))) + "\n"
    if check:
        if not PROJECTS.exists() or PROJECTS.read_text() != projects:
            print("configure project databases")
        return
    STATE.mkdir(parents=True, exist_ok=True, mode=0o700)
    SECRETS.mkdir(parents=True, exist_ok=True, mode=0o700)
    if write_changed(PROJECTS, projects):
        print("configure project databases")


def main(argv):
    if argv == ["--check-docker"]:
        try:
            result = docker("info", optional=True)
        except OSError:
            result = None
        if result is None or result.returncode:
            raise RuntimeError(
                "Project databases need explicit Docker access for this account: "
                "a writable /var/run/docker.sock or sudo -n docker, and a running daemon. "
                "Crewship does not grant Docker privileges."
            )
        return
    if argv[:1] == ["--apply"]:
        if set(argv[1:]) - {"--check"}:
            raise ValueError(__doc__)
        apply(check="--check" in argv)
        return
    if argv == ["--seed"] or 1 <= len(argv) <= 2 and not argv[0].startswith("-"):
        if argv != ["--seed"] and not NAME.fullmatch(argv[0]):
            raise ValueError("Project must be 1-48 letters, digits, underscores or hyphens, starting with a letter")
        SECRETS.mkdir(parents=True, exist_ok=True, mode=0o700)
        with (SECRETS / ".lock").open("a") as lock:
            os.chmod(lock.name, 0o600)
            fcntl.flock(lock, fcntl.LOCK_EX)
            if argv == ["--seed"]:
                seed()
            else:
                directories = checkouts().get(argv[0], []) + [Path(a).resolve() for a in argv[1:]]
                result = project_url(argv[0], directories)
                if result is None:
                    raise RuntimeError(f"No postgres, mysql, mariadb or redis image in a compose file of {argv[0]}")
                path = SECRETS / (argv[0].lower() + ".env")
                write_changed(path, f"{result[0]}={result[1]}\n")
                print(path)
        return
    raise ValueError(__doc__)


if __name__ == "__main__":
    try:
        main(sys.argv[1:])
    except (OSError, RuntimeError, ValueError) as error:
        print(f"crewship-db: {error}", file=sys.stderr)
        sys.exit(1)
