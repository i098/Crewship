+function captureAnthropicUsageMetadata(output: AssistantMessage, source: AnthropicWireUsage, final: boolean): void {
+	const previous = output.usageMetadata;
+	output.usageMetadata = {
+		input_basis: "exclusive",
+		input: source.input_tokens ?? previous?.input ?? null,
+		cache_read: source.cache_read_input_tokens ?? previous?.cache_read ?? null,
+		cache_write: source.cache_creation_input_tokens ?? previous?.cache_write ?? null,
+		output: final ? source.output_tokens ?? null : null,
+		reasoning: null,
+	};
+	const iterations = source.iterations;
+	if (!iterations?.some(iteration => iteration.type === "compaction")) return;
+	const sum = (key: "input_tokens" | "output_tokens" | "cache_read_input_tokens" | "cache_creation_input_tokens") =>
+		iterations.every(iteration => typeof iteration[key] === "number")
+			? iterations.reduce((total, iteration) => total + iteration[key]!, 0) : null;
+	output.usageMetadata = { input_basis: "exclusive", input: sum("input_tokens"),
+		output: final ? sum("output_tokens") : null, cache_read: sum("cache_read_input_tokens"),
+		cache_write: sum("cache_creation_input_tokens"), reasoning: null };
+}
