 #                          and has not been surfaced yet; reported once per
@@ -2057,7 +2061,7 @@ surface_queued_checks() {
   [ -s "$FM_WAKE_QUEUE" ] || return 0
   fm_lock_acquire_wait "$FM_WAKE_QUEUE_LOCK"
   while IFS= read -r key; do
-    case "$key" in procevent:*|inbox:*) ;; *) continue ;; esac
+    case "$key" in procevent:*|inbox:*|board:*) ;; *) continue ;; esac
     [ -e "$(queued_surfaced_marker "$key")" ] && continue
     QUEUED_SURFACED="$QUEUED_SURFACED $key"
     # A stranded source or one whose launch never proved itself is the opposite
@@ -2065,7 +2069,7 @@ surface_queued_checks() {
     # a capture would present it as healthy, which is the shape of defect
     # these wakes exist to surface.
     case "$key" in
-      inbox:*)
+      inbox:*|board:*)
         reason=$(awk -F '\t' -v k="$key" 'NF >= 5 && $3 == "check" && $4 == k { print $5; exit }' "$FM_WAKE_QUEUE")
         notes="$notes; ${reason#check: }" ;;
       procevent:*:stranded:*) stranded="$stranded $key" ;;
@@ -2362,7 +2366,7 @@ queued_inbox_pending() {
   _queue_wait_sig=$sig
   [ -s "$FM_WAKE_QUEUE" ] || return 1
   while IFS= read -r key; do
-    case "$key" in inbox:*) ;; *) continue ;; esac
+    case "$key" in inbox:*|board:*) ;; *) continue ;; esac
     [ -e "$(queued_surfaced_marker "$key")" ] || return 0
   done < <(fm_wake_queued_keys_locked check)
   return 1
@@ -2626,8 +2630,16 @@ pr_poll_publish_release() {
   PR_POLL_PUBLISH_LOCK=
 }
 
+# The crew board's event source (bin/fm-board-bridge.sh): one background
+# subscriber per watcher run, only while the board socket is live. It queues a
+# wake row per message on the fm topic, which queued_inbox_pending and
+# surface_queued_checks above turn into a wake within about 1 s. The bridge
+# exits on its own when this pid is gone; the cleanup below stops it sooner.
+BOARD_BRIDGE_PID=
+
 watcher_cleanup() {
   local cleanup_status=0 owns_lock=0 transition=release-lock
+  [ -z "$BOARD_BRIDGE_PID" ] || kill "$BOARD_BRIDGE_PID" 2>/dev/null || true
   pr_poll_publish_release || cleanup_status=1
   pr_poll_control_release || cleanup_status=1
   if [ "$(cat "$WATCH_LOCK/pid" 2>/dev/null || true)" = "${WATCHER_PID:-}" ]; then
@@ -2664,6 +2676,13 @@ printf '%s\n' "$FM_WATCH_DELIVERY_IDENTITY" > "$WATCH_LOCK/pid-identity" 2>/dev/
 
 [ -e "$STATE/.last-heartbeat" ] || touch "$STATE/.last-heartbeat"
 
+board_sock=${CREWBOARD_SOCKET:-${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/crewboard.sock}
+if [ -S "$board_sock" ] && [ -x "$SCRIPT_DIR/fm-board-bridge.sh" ]; then
+  FM_HOME="$FM_HOME" FM_STATE_OVERRIDE="$STATE" FM_CONFIG_OVERRIDE="$CONFIG" \
+    "$SCRIPT_DIR/fm-board-bridge.sh" --parent "$WATCHER_PID" </dev/null >/dev/null 2>&1 &
+  BOARD_BRIDGE_PID=$!
+fi
+
 # A merged poll may have queued its terminal wake and then lost the process
 # between receipt publication and fixed-path removal.
 # Finish only identity-bound retirement receipts before any check can run.
