diff --git a/tests/fm-board-bridge.test.sh b/tests/fm-board-bridge.test.sh
new file mode 100755
index 00000000..86830408
--- /dev/null
+++ b/tests/fm-board-bridge.test.sh
@@ -0,0 +1,285 @@
+#!/usr/bin/env bash
+# tests/fm-board-bridge.test.sh - the crew board event source
+# (bin/fm-board-bridge.sh) and the watcher wiring that starts it.
+#
+# A fake `crewboard` on PATH prints the NDJSON a real `crewboard sub --json`
+# prints and logs its arguments, so the bridge is driven with real processes:
+#   1. Every fm message queues one durable `check` row, board:<boot>:<seq>, and
+#      moves the cursor; a resubscription resumes with --since and --boot.
+#   2. A first run starts live (no --since, nothing replayed); a changed boot id
+#      replays everything the board retained.
+#   3. task/* is subscribed, and rings a doorbell, only with config/board-doorbell;
+#      a dead pane, an unknown task and a message from the task itself ring nothing.
+#   4. A real fm-watch.sh with a 60 s poll wakes within seconds of an fm message
+#      and leaves no bridge behind; with the board off no bridge ever starts.
+set -u
+
+# shellcheck source=tests/wake-helpers.sh
+. "$(dirname "${BASH_SOURCE[0]}")/wake-helpers.sh"
+
+BRIDGE="$ROOT/bin/fm-board-bridge.sh"
+WATCH="$ROOT/bin/fm-watch.sh"
+TMP_ROOT=$(fm_test_tmproot fm-board-bridge)
+TMP_ROOT=$(cd "$TMP_ROOT" && pwd -P)
+command -v jq >/dev/null 2>&1 || { echo "ok - skipped: jq is not installed"; exit 0; }
+
+# Fixture: <dir>/state, <dir>/config, a fake crewboard and tmux in <dir>/fakebin.
+# The fake prints the lines in $FAKE_BOARD_LINES (one JSON line per row), logs
+# its arguments to $FAKE_BOARD_ARGS, and holds the stream open for
+# $FAKE_BOARD_HOLD seconds.
+make_bridge_case() {  # <name>
+  local dir="$TMP_ROOT/$1" fb
+  fb="$dir/fakebin"
+  mkdir -p "$dir/state" "$dir/config" "$fb"
+  fm_test_track_watcher_state "$dir/state"
+  cat > "$fb/crewboard" <<'SH'
+#!/usr/bin/env bash
+printf '%s\n' "$*" >> "$FAKE_BOARD_ARGS"
+[ ! -f "${FAKE_BOARD_LINES:-}" ] || cat "$FAKE_BOARD_LINES"
+exec sleep "${FAKE_BOARD_HOLD:-0}"
+SH
+  cat > "$fb/tmux" <<'SH'
+#!/usr/bin/env bash
+case "${1:-}" in
+  send-keys)
+    shift
+    literal=0
+    while [ $# -gt 0 ]; do
+      case "$1" in -t) shift 2 ;; -l) literal=1; shift ;; *) break ;; esac
+    done
+    [ "$literal" != 1 ] || printf '%s\n' "${1:-}" >> "${FM_SEND_LOG:-/dev/null}"
+    exit 0 ;;
+  display-message)
+    for a in "$@"; do
+      case "$a" in
+        *cursor_y*) printf '1\n'; exit 0 ;;
+        *pane_current_command*) [ -z "${FM_FAKE_TMUX_AGENT:-}" ] || { printf '%s\n' "$FM_FAKE_TMUX_AGENT"; exit 0; } ;;
+        *pane_tty*) [ -z "${FM_FAKE_TMUX_AGENT:-}" ] || { printf '\n'; exit 0; } ;;
+      esac
+    done
+    printf 'fakepane\n'; exit 0 ;;
+  capture-pane) printf '╭────╮\n│    │\n╰────╯\n'; exit 0 ;;
+  list-windows) printf 'fm-t1\n'; exit 0 ;;
+esac
+exit 0
+SH
+  chmod +x "$fb/crewboard" "$fb/tmux"
+  make_fake_crew_state "$fb" >/dev/null
+  : > "$dir/args"
+  : > "$dir/send.log"
+  printf '%s\n' "$dir"
+}
+
+# Run the bridge on a case dir; $BRIDGE_PARENT is a sleeper whose death ends it.
+bridge_bg() {  # <dir> [env assignments...]
+  local dir=$1
+  shift
+  sleep 120 &
+  BRIDGE_PARENT=$!
+  PATH="$dir/fakebin:$PATH" FM_HOME="$dir" FM_STATE_OVERRIDE="$dir/state" FM_CONFIG_OVERRIDE="$dir/config" \
+    CREWBOARD_SOCKET="$dir/none.sock" FAKE_BOARD_ARGS="$dir/args" FM_SEND_LOG="$dir/send.log" \
+    env "$@" "$BRIDGE" --parent "$BRIDGE_PARENT" >/dev/null 2>&1 &
+  BRIDGE_PID=$!
+}
+
+bridge_stop() {
+  kill "$BRIDGE_PARENT" 2>/dev/null
+  wait_for_exit "$BRIDGE_PID" 100 || true
+  wait "$BRIDGE_PARENT" 2>/dev/null
+}
+
+# Wait up to <ticks> tenths of a second for <file> to contain the fixed string.
+wait_for_text() {  # <file> <text> [ticks]
+  local i=0
+  while [ "$i" -lt "${3:-60}" ]; do
+    grep -F -- "$2" "$1" >/dev/null 2>&1 && return 0
+    sleep 0.1
+    i=$((i + 1))
+  done
+  return 1
+}
+
+# The bridge only needs the socket path to be a socket; a bound, listening
+# python socket is the portable way to make one.
+make_board_socket() {  # <path>
+  python3 -c 'import socket, sys, time
+s = socket.socket(socket.AF_UNIX); s.bind(sys.argv[1]); s.listen(); time.sleep(120)' "$1" &
+  BOARD_SOCKET_PID=$!
+  local i=0
+  while [ ! -S "$1" ] && [ "$i" -lt 50 ]; do sleep 0.1; i=$((i + 1)); done
+  [ -S "$1" ] || fail "the test socket was not created"
+}
+
+test_fm_messages_queue_rows_and_resume_from_the_cursor() {
+  local dir sock
+  dir=$(make_bridge_case rows); sock="$dir/board.sock"
+  make_board_socket "$sock"
+  cat > "$dir/lines" <<'EOF'
+{"boot":"b1","seq":4}
+{"seq":5,"ts":"2026-10-09T20:14:03.117Z","topic":"fm","from":"t1","pid":1,"body":"needs-decision: pick a db"}
+{"seq":6,"ts":"2026-10-09T20:14:04.117Z","topic":"fleet","from":"t2","pid":1,"body":"not for firstmate"}
+{"seq":7,"ts":"2026-10-09T20:14:05.117Z","topic":"fm","from":null,"pid":1,"body":"line one\nline two\ttabbed"}
+EOF
+  bridge_bg "$dir" CREWBOARD_SOCKET="$sock" FAKE_BOARD_LINES="$dir/lines"
+  wait_for_text "$dir/state/.wake-queue" "board:b1:7" || fail "the fm messages queued no rows: $(cat "$dir/state/.wake-queue" 2>/dev/null)"
+  [ "$(awk -F '\t' '$3 == "check"' "$dir/state/.wake-queue" | wc -l | tr -d ' ')" = 2 ] \
+    || fail "expected exactly two rows (the fleet message is not for firstmate): $(cat "$dir/state/.wake-queue")"
+  awk -F '\t' '$4 == "board:b1:5" { print $5 }' "$dir/state/.wake-queue" | grep -Fx "check: crew board fm #5 from t1 - needs-decision: pick a db" >/dev/null \
+    || fail "the first row has the wrong reason: $(cat "$dir/state/.wake-queue")"
+  awk -F '\t' '$4 == "board:b1:7" { print $5 }' "$dir/state/.wake-queue" | grep -Fx 'check: crew board fm #7 from unknown - line one\nline two\ttabbed' >/dev/null \
+    || fail "a multi-line body must stay on one row: $(cat "$dir/state/.wake-queue")"
+  [ "$(cat "$dir/state/.board-cursor")" = "$(printf 'b1\t7')" ] || fail "the cursor did not reach seq 7: $(cat "$dir/state/.board-cursor")"
+  # The first subscription is live (no cursor); the stream ended, so the next one resumes.
+  [ "$(sed -n 1p "$dir/args")" = "sub --json fm" ] || fail "the first run must start live: $(cat "$dir/args")"
+  wait_for_text "$dir/args" "sub --json fm --since 7 --boot b1" 80 || fail "the bridge did not resume from its cursor: $(cat "$dir/args")"
+  bridge_stop; kill "$BOARD_SOCKET_PID" 2>/dev/null
+  pass "bridge: fm messages queue one row each, the cursor moves, and a resubscribe resumes from it"
+}
+
+test_a_restarted_board_replays_what_it_retained() {
+  local dir sock
+  dir=$(make_bridge_case restart); sock="$dir/board.sock"
+  make_board_socket "$sock"
+  printf 'old\t90\n' > "$dir/state/.board-cursor"
+  cat > "$dir/lines" <<'EOF'
+{"boot":"new","seq":2}
+{"gap":true,"oldest":1,"restarted":true}
+{"seq":1,"ts":"2026-10-09T20:14:03.117Z","topic":"fm","from":"t1","pid":1,"body":"after the restart"}
+EOF
+  bridge_bg "$dir" CREWBOARD_SOCKET="$sock" FAKE_BOARD_LINES="$dir/lines" FAKE_BOARD_HOLD=30
+  wait_for_text "$dir/state/.wake-queue" "board:new:1" || fail "a message of the new boot queued no row: $(cat "$dir/state/.wake-queue" 2>/dev/null)"
+  [ "$(sed -n 1p "$dir/args")" = "sub --json fm --since 90 --boot old" ] || fail "the bridge must resume with the old cursor: $(cat "$dir/args")"
+  [ "$(cat "$dir/state/.board-cursor")" = "$(printf 'new\t1')" ] || fail "the cursor must follow the new boot: $(cat "$dir/state/.board-cursor")"
+  bridge_stop; kill "$BOARD_SOCKET_PID" 2>/dev/null
+  pass "bridge: a restarted board's retained messages all queue and the cursor follows the new boot"
+}
+
+test_task_doorbell_needs_the_opt_in_and_a_live_pane() {
+  local dir sock
+  dir=$(make_bridge_case doorbell); sock="$dir/board.sock"
+  make_board_socket "$sock"
+  fm_write_meta "$dir/state/t1.meta" "window=sess:fm-t1" "kind=ship"
+  cat > "$dir/lines" <<'EOF'
+{"boot":"b1","seq":0}
+{"seq":1,"ts":"2026-10-09T20:14:03.117Z","topic":"task/t1","from":"t2","pid":1,"body":"I changed the API"}
+{"seq":2,"ts":"2026-10-09T20:14:03.117Z","topic":"task/t1","from":"t1","pid":1,"body":"note to self"}
+{"seq":3,"ts":"2026-10-09T20:14:03.117Z","topic":"task/nobody","from":"t2","pid":1,"body":"nobody home"}
+{"seq":4,"ts":"2026-10-09T20:14:03.117Z","topic":"task/../x","from":"t2","pid":1,"body":"hostile"}
+EOF
+  # Off by default: no task/* subscription and no ring.
+  bridge_bg "$dir" CREWBOARD_SOCKET="$sock" FAKE_BOARD_LINES="$dir/lines" FAKE_BOARD_HOLD=30
+  wait_for_text "$dir/args" "sub" || fail "the bridge never subscribed"
+  sleep 1
+  [ "$(sed -n 1p "$dir/args")" = "sub --json fm" ] || fail "task/* must not be subscribed without the opt-in: $(cat "$dir/args")"
+  [ ! -s "$dir/send.log" ] || fail "a doorbell rang without the opt-in: $(cat "$dir/send.log")"
+  bridge_stop
+
+  # On: one ring for the live task t1 and none for the other three messages.
+  : > "$dir/args"; rm -f "$dir/state/.board-cursor"; : > "$dir/config/board-doorbell"
+  bridge_bg "$dir" CREWBOARD_SOCKET="$sock" FAKE_BOARD_LINES="$dir/lines" FAKE_BOARD_HOLD=30
+  wait_for_text "$dir/send.log" "Crew board message for you on task/t1" 80 || fail "the doorbell never rang task t1"
+  [ "$(sed -n 1p "$dir/args")" = "sub --json fm task/*" ] || fail "task/* must be subscribed with the opt-in: $(cat "$dir/args")"
+  wait_for_text "$dir/state/.board-cursor" "b1" 20 && sleep 1
+  [ "$(grep -c . "$dir/send.log")" = 1 ] || fail "only t1's message from another task may ring: $(cat "$dir/send.log")"
+  grep -F "crewboard tail task/t1" "$dir/send.log" >/dev/null || fail "the bell must name the command that reads it: $(cat "$dir/send.log")"
+  [ ! -s "$dir/state/.wake-queue" ] || fail "a task message must not wake firstmate: $(cat "$dir/state/.wake-queue")"
+  bridge_stop
+
+  # A dead pane (a bare shell) is never typed into.
+  : > "$dir/send.log"; : > "$dir/args"; rm -f "$dir/state/.board-cursor"
+  bridge_bg "$dir" CREWBOARD_SOCKET="$sock" FAKE_BOARD_LINES="$dir/lines" FAKE_BOARD_HOLD=30 FM_FAKE_TMUX_AGENT=zsh
+  wait_for_text "$dir/args" "sub" || fail "the bridge never subscribed"
+  sleep 2
+  [ ! -s "$dir/send.log" ] || fail "a dead pane was typed into: $(cat "$dir/send.log")"
+  bridge_stop; kill "$BOARD_SOCKET_PID" 2>/dev/null
+  pass "bridge: task/* rings only with the opt-in, only for a live task other than the sender"
+}
+
+test_the_bridge_leaves_when_its_parent_is_gone_and_idles_without_a_board() {
+  local dir i=0
+  dir=$(make_bridge_case orphan)
+  bridge_bg "$dir" FAKE_BOARD_HOLD=30
+  sleep 1
+  kill -0 "$BRIDGE_PID" 2>/dev/null || fail "the bridge must idle, not exit, while the board socket is absent"
+  [ ! -s "$dir/args" ] || fail "the bridge subscribed with no board socket: $(cat "$dir/args")"
+  kill "$BRIDGE_PARENT"
+  wait_for_exit "$BRIDGE_PID" 50 || fail "the bridge outlived its parent"
+  wait "$BRIDGE_PARENT" 2>/dev/null
+  while pgrep -f "$dir/fakebin/crewboard" >/dev/null 2>&1 && [ "$i" -lt 30 ]; do sleep 0.1; i=$((i + 1)); done
+  pass "bridge: idles without a board and leaves with its parent"
+}
+
+watch_bg() {  # <dir> <out> [env assignments...]
+  local dir=$1 out=$2
+  shift 2
+  PATH="$dir/fakebin:$PATH" FM_HOME="$dir" FM_STATE_OVERRIDE="$dir/state" FM_CONFIG_OVERRIDE="$dir/config" \
+    FM_CREW_STATE_BIN="$dir/fakebin/fm-crew-state.sh" FAKE_BOARD_ARGS="$dir/args" \
+    FM_POLL=60 FM_SIGNAL_GRACE=1 FM_CHECK_INTERVAL=999999 FM_HEARTBEAT=999999 \
+    env "$@" "$WATCH" > "$out" 2>/dev/null &
+}
+
+test_a_board_message_ends_a_long_idle_wait() {
+  local dir sock out pid i=0
+  dir=$(make_bridge_case watch-wake); sock="$dir/board.sock"; out="$dir/watch.out"
+  make_board_socket "$sock"
+  # The board delivers the message 3 s into the subscription, while the watcher idles.
+  cat > "$dir/fakebin/crewboard" <<'SH'
+#!/usr/bin/env bash
+printf '%s\n' "$*" >> "$FAKE_BOARD_ARGS"
+printf '{"boot":"b1","seq":0}\n'
+sleep 3
+printf '{"seq":1,"ts":"2026-10-09T20:14:03.117Z","topic":"fm","from":"t1","pid":1,"body":"needs-decision: ship it?"}\n'
+exec sleep 60
+SH
+  watch_bg "$dir" "$out" CREWBOARD_SOCKET="$sock"
+  pid=$!
+  wait_for_text "$dir/args" "sub --json fm" || fail "the watcher never started the bridge: $(cat "$out")"
+  wait_for_exit "$pid" 100 || fail "an fm message did not end a 60 s idle wait within 10 s"
+  grep -Fx "check: crew board fm #1 from t1 - needs-decision: ship it?" "$out" >/dev/null || fail "the wake did not name the message: $(cat "$out")"
+  [ "$(grep -c . "$out")" = 1 ] || fail "the message did not produce exactly one wake: $(cat "$out")"
+  while pgrep -f "$dir/fakebin/crewboard" >/dev/null 2>&1 && [ "$i" -lt 50 ]; do sleep 0.1; i=$((i + 1)); done
+  ! pgrep -f "$dir/fakebin/crewboard" >/dev/null 2>&1 || fail "the exited watcher left a board subscriber running"
+  kill "$BOARD_SOCKET_PID" 2>/dev/null
+  pass "watcher: an fm board message wakes an idle watcher within seconds and leaves no bridge behind"
+}
+
+test_a_surfaced_board_message_wakes_a_successor_watcher_only_once() {
+  local dir sock out pid
+  dir=$(make_bridge_case watch-once); sock="$dir/board.sock"; out="$dir/watch.out"
+  make_board_socket "$sock"
+  append_wake "$dir/state" check "board:b1:1" "check: crew board fm #1 from t1 - already told"
+  # Mark the row surfaced the way a first wake would have.
+  : > "$dir/state/.seen-board-$(printf '%s' 'board:b1:1' | LC_ALL=C od -An -tx1 | tr -d ' \n')"
+  printf 'b1\t1\n' > "$dir/state/.board-cursor"
+  printf '{"boot":"b1","seq":1}\n' > "$dir/lines"
+  watch_bg "$dir" "$out" CREWBOARD_SOCKET="$sock" FAKE_BOARD_LINES="$dir/lines" FAKE_BOARD_HOLD=60 FM_WATCH_HANDLING_SUCCESSOR=1
+  pid=$!
+  wait_for_text "$dir/args" "sub --json fm --since 1 --boot b1" || fail "the successor bridge did not resume: $(cat "$dir/args")"
+  sleep 3
+  kill -0 "$pid" 2>/dev/null || fail "a surfaced board message woke the successor again: $(cat "$out")"
+  kill "$pid" 2>/dev/null; wait "$pid" 2>/dev/null
+  kill "$BOARD_SOCKET_PID" 2>/dev/null
+  pass "watcher: a surfaced board message does not wake a successor watcher again"
+}
+
+test_no_bridge_starts_with_the_board_off() {
+  local dir out pid
+  dir=$(make_bridge_case board-off); out="$dir/watch.out"
+  watch_bg "$dir" "$out" CREWBOARD_SOCKET="$dir/absent.sock"
+  pid=$!
+  sleep 3
+  kill -0 "$pid" 2>/dev/null || fail "the watcher exited with no board: $(cat "$out")"
+  ! pgrep -f "fm-board-bridge.sh --parent $pid" >/dev/null 2>&1 || fail "a bridge ran with the board off"
+  [ ! -s "$dir/args" ] || fail "crewboard was called with the board off: $(cat "$dir/args")"
+  [ ! -e "$dir/state/.board-cursor" ] || fail "the board off left a cursor"
+  kill "$pid" 2>/dev/null; wait "$pid" 2>/dev/null
+  pass "watcher: with the board off no bridge starts and no state is written"
+}
