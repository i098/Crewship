diff --git a/bin/fm-task-inbox-lib.sh b/bin/fm-task-inbox-lib.sh
index 3b87a429..1910f90f 100644
--- a/bin/fm-task-inbox-lib.sh
+++ b/bin/fm-task-inbox-lib.sh
@@ -353,12 +353,16 @@ fm_task_inbox_doorbell_line() {  # <record-path>
 # whose Enter never landed, so on an agent not reported busy it is submitted
 # rather than skipped; skipping it would block every later ring. On both paths
 # a lost first Enter gets one confirmed retry.
+# FM_TASK_INBOX_DOORBELL_LINE, when set, replaces the steering-inbox line for
+# one call (the crew board bridge, bin/fm-board-bridge.sh); the checks above
+# and below apply to it unchanged, and <record-path> is then unused.
 fm_task_inbox_ring() {  # <backend> <target> <record-path> [expected-label]
   local backend=$1 target=$2 rec=$3 label=${4:-} line cstate verdict
   case "$(fm_backend_agent_state "$backend" "$target" 2>/dev/null || true)" in
     dead|missing) return 3 ;;
   esac
-  if ! line=$(fm_task_inbox_doorbell_line "$rec"); then
+  line=${FM_TASK_INBOX_DOORBELL_LINE:-}
+  if [ -z "$line" ] && ! line=$(fm_task_inbox_doorbell_line "$rec"); then
     return 2
   fi
   cstate=$(fm_backend_composer_state "$backend" "$target" "$label" 2>/dev/null) || cstate=unknown
