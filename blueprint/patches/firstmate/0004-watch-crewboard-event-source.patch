diff --git a/bin/fm-board-bridge.sh b/bin/fm-board-bridge.sh
new file mode 100755
index 00000000..fde7d4c9
--- /dev/null
+++ b/bin/fm-board-bridge.sh
@@ -0,0 +1,168 @@
+#!/usr/bin/env bash
+# fm-board-bridge.sh - the crew board's event source for bin/fm-watch.sh.
+#
+# The watcher starts one bridge per run while the board socket is a live Unix
+# socket (CREWBOARD_SOCKET, else $XDG_RUNTIME_DIR/crewboard.sock, else
+# /run/user/<uid>/crewboard.sock) and `crewboard` and `jq` are on PATH, and
+# stops it on exit. Board off: nothing starts and nothing changes.
+#
+#   fm      every message queues one durable `check` wake row,
+#           board:<boot>:<seq>, "check: crew board fm #<seq> from <from> - <body>".
+#           bin/fm-watch.sh surfaces the row like a captain inbox note: the
+#           idle wait ends within about 1 s and firstmate wakes once per
+#           message. The row is a hint; the status file still owns done,
+#           blocked, needs-decision, failed and paused.
+#   task/*  only when config/board-doorbell exists: a message on task/<id>
+#           rings the doorbell of task <id>'s pane when its agent is not busy.
+#           It reuses fm_task_inbox_ring, so a dead endpoint and a composer
+#           that holds someone's half-typed text are never typed into. A busy
+#           worker reads the board at its checkpoints, and a skipped bell is
+#           not retried; the message stays on the board.
+#
+# The board's own seq is the cursor: state/.board-cursor holds "<boot>\t<seq>"
+# after each handled message, so a successor watcher resumes with --since and
+# --boot and nothing published between two watchers is lost (the board still
+# drops what its ring dropped). A first run has no cursor and starts live, so
+# old history never wakes anyone. The row is written before the cursor, so a
+# crash can repeat a row (the same key, surfaced once) but never lose one.
+#
+# usage: fm-board-bridge.sh [--parent <pid>]
+#   --parent  exit when that pid is gone, so a killed watcher leaves no bridge
+set -u
+
+SCRIPT_DIR="$(d=${BASH_SOURCE[0]%/*}; [ "$d" != "${BASH_SOURCE[0]}" ] || d=.; cd "${d:-/}" && pwd)"
+FM_ROOT="${FM_ROOT_OVERRIDE:-$(cd "$SCRIPT_DIR/.." && pwd)}"
+FM_HOME="${FM_HOME:-${FM_ROOT_OVERRIDE:-$FM_ROOT}}"
+STATE="${FM_STATE_OVERRIDE:-$FM_HOME/state}"
+CONFIG="${FM_CONFIG_OVERRIDE:-$FM_HOME/config}"
+BOARD_SOCK=${CREWBOARD_SOCKET:-${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/crewboard.sock}
+CURSOR="$STATE/.board-cursor"
+
+PARENT=
+[ "${1:-}" != --parent ] || PARENT=${2:-}
+
+parent_alive() { [ -z "$PARENT" ] || kill -0 "$PARENT" 2>/dev/null; }
+
+nap() {  # <secs>: sleep in 1 s slices, leaving as soon as the parent is gone
+  local left=$1
+  while [ "$left" -gt 0 ]; do
+    parent_alive || exit 0
+    sleep 1
+    left=$((left - 1))
+  done
+}
+
+command -v crewboard >/dev/null 2>&1 && command -v jq >/dev/null 2>&1 || exit 0
+# shellcheck source=bin/fm-wake-lib.sh
+FM_ROOT_OVERRIDE="$FM_ROOT" FM_HOME="$FM_HOME" STATE="$STATE" . "$SCRIPT_DIR/fm-wake-lib.sh" || exit 1
+
+CUR_BOOT= CUR_SEQ=
+read_cursor() {
+  CUR_BOOT= CUR_SEQ=
+  { IFS=$'\t' read -r CUR_BOOT CUR_SEQ < "$CURSOR"; } 2>/dev/null || true
+  case "$CUR_SEQ" in ''|*[!0-9]*) CUR_BOOT= CUR_SEQ= ;; esac
+}
+
+write_cursor() {  # <boot> <seq>
+  printf '%s\t%s\n' "$1" "$2" > "$CURSOR.tmp.$$" && mv -f "$CURSOR.tmp.$$" "$CURSOR"
+}
+
+# A first run (no cursor) starts at the board's seq now. A different boot id
+# means the board restarted: every retained message is new, so resume from 0.
+on_boot() {  # <boot> <seq>
+  read_cursor
+  if [ -z "$CUR_BOOT" ]; then
+    write_cursor "$1" "$2"
+  elif [ "$CUR_BOOT" != "$1" ]; then
+    write_cursor "$1" 0
+  fi
+  BOOT=$1
+}
+
+RING_LIB=
+ring_task() {  # <task-id> <from>
+  local id=$1 from=$2 meta backend target
+  case "$id" in ''|*[!A-Za-z0-9._-]*) return 0 ;; esac
+  [ "$id" != "$from" ] || return 0
+  meta="$STATE/$id.meta"
+  [ -f "$meta" ] || return 0
+  if [ -z "$RING_LIB" ]; then
+    # shellcheck source=bin/fm-task-inbox-lib.sh
+    . "$SCRIPT_DIR/fm-task-inbox-lib.sh" || return 0
+    RING_LIB=1
+  fi
+  target=$(fm_backend_target_of_meta "$meta")
+  [ -n "$target" ] || return 0
+  backend=$(fm_backend_of_meta "$meta")
+  [ "$(fm_backend_busy_state "$backend" "$target" 2>/dev/null || true)" != busy ] || return 0
+  FM_TASK_INBOX_DOORBELL_LINE=": Crew board message for you on task/$id: run 'crewboard tail task/$id -n 5', read it, then continue." \
+    fm_task_inbox_ring "$backend" "$target" "" "fm-$id" || true
+}
+
+on_message() {  # <seq> <topic> <from> <body>
+  local seq=$1 topic=$2 from=$3 body=$4
+  case "$topic" in
+    fm) fm_wake_append check "board:$BOOT:$seq" "check: crew board fm #$seq from $from - $body" || return 1 ;;
+    task/*) [ ! -e "$CONFIG/board-doorbell" ] || ring_task "${topic#task/}" "$from" ;;
+  esac
+  write_cursor "$BOOT" "$seq"
+}
+
+# One TSV record per board line: boot, msg, or other (a gap notice needs no action).
+handle_line() {  # <json line>
+  local kind a b c d
+  IFS=$'\t' read -r kind a b c d < <(printf '%s\n' "$1" | jq -r '
+    if has("boot") then ["boot", .boot, .seq]
+    elif has("seq") and has("topic") then ["msg", .seq, .topic, (.from // "unknown"), (.body | tostring | .[0:200])]
+    else ["other"] end | @tsv' 2>/dev/null)
+  case "$kind" in
+    boot) on_boot "$a" "$b" ;;
+    msg) on_message "$a" "$b" "$c" "$d" ;;
+  esac
+}
+
+FIFO_DIR=$(mktemp -d "${TMPDIR:-/tmp}/fm-board-bridge.XXXXXX") || exit 1
+FIFO="$FIFO_DIR/board"
+mkfifo "$FIFO" || exit 1
+SUB_PID=
+BOOT=
+cleanup() {
+  [ -z "$SUB_PID" ] || kill "$SUB_PID" 2>/dev/null
+  rm -rf "$FIFO_DIR"
+}
+trap cleanup EXIT
+trap 'exit 0' HUP INT TERM
+
+delay=1
+while parent_alive; do
+  if [ -S "$BOARD_SOCK" ]; then
+    read_cursor
+    args=(sub --json fm)
+    [ ! -e "$CONFIG/board-doorbell" ] || args+=('task/*')
+    [ -z "$CUR_BOOT" ] || args+=(--since "$CUR_SEQ" --boot "$CUR_BOOT")
+    crewboard "${args[@]}" > "$FIFO" 2>/dev/null &
+    SUB_PID=$!
+    exec 3< "$FIFO"
+    began=$SECONDS
+    while parent_alive; do
+      started=$SECONDS
+      if IFS= read -r -t 1 line <&3; then
+        handle_line "$line" || exit 1
+      else
+        rc=$?
+        # Bash 4+ reports a timeout above 128. Bash 3.2 returns 1 for a timeout
+        # and for EOF, but only a timeout spends a whole second.
+        [ "$rc" -gt 128 ] || [ "$SECONDS" -ne "$started" ] || break
+      fi
+    done
+    exec 3<&-
+    kill "$SUB_PID" 2>/dev/null
+    wait "$SUB_PID" 2>/dev/null
+    SUB_PID=
+    # A subscription that lived 10 s was healthy; a dead board backs off to 30 s.
+    if [ $((SECONDS - began)) -ge 10 ]; then delay=1; else delay=$((delay * 2 > 30 ? 30 : delay * 2)); fi
+    nap "$delay"
+  else
+    nap 5
+  fi
+done
