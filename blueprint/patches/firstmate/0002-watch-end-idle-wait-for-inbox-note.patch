   dir=$(cd "$dir" && pwd -P) || return 1
   PATH="$dir/fakebin:$PATH" FM_HOME="$dir" FM_PROCEVENT_CLAIM_ROOT="$dir/claims" \
     FM_CREW_STATE_BIN="$dir/fakebin/fm-crew-state.sh" \
-    FM_POLL=0.2 FM_SIGNAL_GRACE=1 FM_CHECK_INTERVAL=999999 FM_HEARTBEAT=999999 "$WATCH" > "$out" &
+    FM_POLL="$poll" FM_SIGNAL_GRACE=1 FM_CHECK_INTERVAL=999999 FM_HEARTBEAT=999999 "$WATCH" > "$out" &
 }
 
 test_procevent_captured_result_surfaces_proactively() {
@@ -5920,6 +5920,24 @@ test_inbox_note_wakes_idle_watcher() {
   pass "a captain inbox note wakes an idle watcher once"
 }
 
+# The idle wait must not hold a note for the poll budget: with a 60 s poll the
+# note still wakes the watcher within a few seconds.
+test_inbox_note_ends_long_idle_wait() {
+  local dir state out pid i=0
+  dir=$(make_case inbox-note-long-poll); state="$dir/state"; out="$dir/watch.out"
+  procevent_watch_bg "$dir" "$out" 60
+  pid=$!
+  while [ ! -e "$state/.last-watcher-beat" ] && [ "$i" -lt 100 ]; do sleep 0.1; i=$((i + 1)); done
+  [ -e "$state/.last-watcher-beat" ] || fail "the watcher never reached its idle wait: $(cat "$out")"
+  sleep 2
+  kill -0 "$pid" 2>/dev/null || fail "the watcher left its idle wait without a note: $(cat "$out")"
+  FM_HOME="$dir" FM_STATE_OVERRIDE="$state" "$ROOT/bin/fm-inbox.sh" note "answer me now" >/dev/null 2>&1 \
+    || fail "fm-inbox.sh note failed"
+  wait_for_exit "$pid" 50 || fail "a note did not end a 60 s idle wait within 5 s"
+  grep -F "answer me now" "$out" >/dev/null || fail "the early wake did not name the note: $(cat "$out")"
+  pass "a captain inbox note ends a long idle wait within seconds"
+}
+
 # The reason line is the headline firstmate reads before the payload. Every
 # procevent:* key used to surface as "process-event result captured", which
 # presents a source that is collecting NOTHING as a healthy capture - the exact
@@ -6765,6 +6783,7 @@ test_procevent_surface_serializes_with_drain
 test_procevent_surface_crash_boundaries
 test_procevent_marker_failure_exits_and_replays
 test_inbox_note_wakes_idle_watcher
+test_inbox_note_ends_long_idle_wait
