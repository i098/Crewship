+test_watcher_hook_queues_decisions_only_where_enabled() {
+  local h
+  h=$(fresh_home hook)
+  task "$h" w ship 'needs-decision [at=1] [key=k1]: q'
+  task "$h" sm secondmate 'done [at=5]: chunk 3 finished'
+  hook() {  # <file> <owned>
+    FM_HOME="$h" STATE="$h/state" CONFIG="$h/config" FM_STATE_OVERRIDE="$h/state" FM_CONFIG_OVERRIDE="$h/config" FM_ROOT="$ROOT" FM_DQ_SELF="$DQ" FM_DQ_IMESSAGE="$h/stubs/say" bash -c \
+      '. "$FM_ROOT/bin/fm-classify-lib.sh"; . "$FM_ROOT/bin/fm-decision-queue-lib.sh"; dq_watch_file "$1" "$2"' _ "$@"
+  }
+  hook "$h/state/w.status" 1 && fail "a home without config/decision-queue queued a decision"
+  assert_absent "$h/state/decision-queue" "off by default"
+  : > "$h/config/decision-queue"
+  hook "$h/state/w.status" 1 || fail "an enabled home kept the decision in chat"
+  assert_equals "w+k1" "$(dq "$h" list)" "decision queued"
+  hook "$h/state/sm.status" 0 && fail "a done line is not a decision"
+  sleep 1
+  assert_equals "sm: chunk 3 finished" "$(cat "$h/texts.log")" "second mate done sends one progress line"
+  pass "the watcher hook queues decisions and texts second-mate progress only when enabled"
+}
+
+test_watcher_tick_dispatches_a_queued_decision_without_a_manual_call() {
+  local h n=0
+  h=$(fresh_home tick)
+  task "$h" w ship 'needs-decision [at=1] [key=k1]: q'
+  : > "$h/config/decision-queue"
+  tick() {
+    FM_HOME="$h" STATE="$h/state" CONFIG="$h/config" FM_STATE_OVERRIDE="$h/state" FM_CONFIG_OVERRIDE="$h/config" \
+      FM_DATA_OVERRIDE="$h/data" FM_ROOT="$ROOT" FM_DQ_SELF="$DQ" FM_DQ_IMESSAGE="$h/stubs/say" FM_DQ_BRIEF="$h/stubs/brief" \
+      FM_DQ_SPAWN="$h/stubs/spawn" bash -c '. "$FM_ROOT/bin/fm-classify-lib.sh"; . "$FM_ROOT/bin/fm-decision-queue-lib.sh"; dq_tick'
+  }
+  tick
+  while [ ! -s "$h/spawned.log" ] && [ $n -lt 100 ]; do sleep 0.1; n=$((n + 1)); done
+  assert_equals "dq-" "$(cut -c1-3 "$h/spawned.log")" "the tick imported and spawned a crewmate"
+  assert_equals "w+k1" "$(dq "$h" list dispatched)" "record dispatched"
+  tick; sleep 1
+  assert_equals "1" "$(wc -l < "$h/spawned.log" | tr -d ' ')" "a second tick inside the interval does nothing"
+  pass "the watcher tick picks up a queued decision with no manual call"
+}
+
+test_a_failed_text_keeps_a_record_out_of_stuck() {
+  local h
+  h=$(fresh_home stuck)
+  task "$h" w ship 'needs-decision [at=1] [key=k1]: q'
+  dq "$h" enqueue w k1 needs-decision q >/dev/null
+  printf '#!/usr/bin/env bash\nexit 1\n' > "$h/stubs/spawn"
+  cp "$h/stubs/say" "$h/stubs/say.ok"; printf '#!/usr/bin/env bash\nexit 1\n' > "$h/stubs/say"
+  FM_DQ_ATTEMPTS=1 dq "$h" dispatch >/dev/null 2>&1
+  assert_equals "" "$(dq "$h" list stuck)" "no stuck record while the owner text fails"
+  cp "$h/stubs/say.ok" "$h/stubs/say"
+  FM_DQ_ATTEMPTS=1 dq "$h" dispatch >/dev/null 2>&1
+  assert_equals "w+k1" "$(dq "$h" list stuck)" "stuck once the text is sent"
+  assert_equals "1" "$(grep -c 'stuck' "$h/texts.log")" "one owner text"
+  pass "a record turns stuck only with an owner text sent"
+}
