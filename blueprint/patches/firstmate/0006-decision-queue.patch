+test_a_reworded_note_on_a_dispatched_record_keeps_its_crewmate() {
+  local h rec
+  h=$(fresh_home renote)
+  task "$h" w ship 'needs-decision [at=1] [key=k1]: q'
+  dq "$h" enqueue w k1 needs-decision 'pick a or b' >/dev/null
+  dq "$h" dispatch >/dev/null
+  assert_equals "dup" "$(dq "$h" enqueue w k1 needs-decision 'pick c or d')" "a reworded note on a live record is not a requeue"
+  dq "$h" dispatch >/dev/null
+  assert_equals "w+k1" "$(dq "$h" list dispatched)" "still dispatched"
+  assert_equals "1" "$(wc -l < "$h/spawned.log" | tr -d ' ')" "no second crewmate"
+  rec="$h/state/decision-queue/w+k1.rec"
+  assert_equals "pick c or d" "$(sed -n 's/^note=//p' "$rec")" "note updated"
+  pass "a reworded note on a dispatched record keeps its crewmate"
+}
