+test_progress_is_one_line_deduped_and_rate_limited() {
+  local h
+  h=$(fresh_home progress)
+  dq "$h" progress web-mate 'chunk 1 done'
+  dq "$h" progress web-mate 'chunk 1 done'
+  dq "$h" progress web-mate 'chunk 2 done'
+  assert_equals "web-mate: chunk 1 done" "$(cat "$h/texts.log")" "same line and fast repeat are dropped"
+  FM_DQ_PROGRESS_INTERVAL=0 dq "$h" progress web-mate 'chunk 2 done'
+  assert_equals "2" "$(wc -l < "$h/texts.log" | tr -d ' ')" "a later line goes out after the interval"
+  pass "progress texts are one line, deduped, and rate limited"
+}
