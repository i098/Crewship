new file mode 100755
index 00000000..827745a7
--- /dev/null
+++ b/bin/fm-decision-queue.sh
@@ -0,0 +1,195 @@
+#!/usr/bin/env bash
+# fm-decision-queue.sh - keep needs-decision and blocked lines out of chat.
+#
+# A decision lands as one durable record under state/decision-queue/ (the watcher
+# enqueues it where config/decision-queue exists). One crewmate per record texts
+# the owner through fm-imessage, relays the answer, and closes the record.
+#
+# Usage:
+#   fm-decision-queue.sh enqueue <origin> <key> <verb> <note...>
+#   fm-decision-queue.sh import [--dry-run]     queue this home's open decisions; drop stale ones
+#   fm-decision-queue.sh dispatch [--dry-run] [--max N]
+#                                               one crewmate per queued record, at most N at once
+#                                               (default 3); the overflow goes out as one digest text
+#   fm-decision-queue.sh list [<state>]         ids in state queued (default), dispatched, closed, stuck
+#   fm-decision-queue.sh ask <id> <text...>     text the owner; the text carries the reply tag
+#   fm-decision-queue.sh await <id> [--timeout S] [--interval S]
+#                                               print the owner's tagged reply; exit 3 on timeout
+#   fm-decision-queue.sh close <id> [reason]    mark the record closed
+#   fm-decision-queue.sh progress <mate> <note...>   one rate-limited progress text
+#
+# A record id is <origin>+<key>. Environment: FM_DQ_MAX (3), FM_DQ_DIGEST_INTERVAL
+# (3600 s), FM_DQ_PROGRESS_INTERVAL (600 s), FM_DQ_ATTEMPTS (3 spawns per record),
+# FM_DQ_IMESSAGE (the text sender, default fm-imessage), FM_DQ_REPLY_LOG (the
+# bridge's routing.jsonl, default under $STATE_DIRECTORY or ~/.local/state/fm-imessage).
+# The reply log needs jq.
+set -u
+
+SCRIPT_DIR="$(d=${BASH_SOURCE[0]%/*}; [ "$d" != "${BASH_SOURCE[0]}" ] || d=.; cd "${d:-/}" && pwd)"
+FM_ROOT="${FM_ROOT_OVERRIDE:-$(cd "$SCRIPT_DIR/.." && pwd)}"
+FM_HOME="${FM_HOME:-${FM_ROOT_OVERRIDE:-$FM_ROOT}}"
+STATE="${FM_STATE_OVERRIDE:-$FM_HOME/state}"
+DATA="${FM_DATA_OVERRIDE:-$FM_HOME/data}"
+# shellcheck source=bin/fm-classify-lib.sh
+. "$SCRIPT_DIR/fm-classify-lib.sh"
+# shellcheck source=bin/fm-decision-queue-lib.sh
+. "$SCRIPT_DIR/fm-decision-queue-lib.sh"
+
+usage() { sed -n '2,/^set -u/p' "$0" | sed '$d' | cut -c3-; }
+die() { echo "fm-decision-queue: $*" >&2; exit 1; }
+need_id() { [ -f "$(dq_path "${1:-}")" ] || die "no record: ${1:-}"; }
+
+cmd_import() {
+  local dry=0 f origin key verb note last lverb found=0 new=0 dup=0 gone=0 moved=0 out
+  [ "${1:-}" != --dry-run ] || dry=1
+  for f in "$STATE"/*.status; do
+    [ -f "$f" ] || continue
+    origin=$(basename "$f" .status)
+    dq_slug_ok "$origin" || continue
+    last=$(last_status_line "$f"); status_line_verb "$last" lverb
+    while IFS=$'\t' read -r key verb note; do
+      [ -n "$key" ] || continue
+      found=$((found + 1))
+      if [ ! -f "$STATE/$origin.meta" ]; then gone=$((gone + 1)); continue; fi
+      case "$lverb" in needs-decision|blocked) ;; *) moved=$((moved + 1)); continue ;; esac
+      if [ "$dry" = 1 ]; then
+        [ -f "$(dq_path "$(dq_id "$origin" "$key")")" ] && dup=$((dup + 1)) || new=$((new + 1))
+        continue
+      fi
+      out=$(dq_enqueue "$origin" "$key" "$verb" "$note") || continue
+      case "$out" in dup) dup=$((dup + 1)) ;; *) new=$((new + 1)) ;; esac
+    done <<EOF
+$(status_own_open_decisions "$f")
+EOF
+  done
+  printf '%sopen=%s new=%s already-queued=%s stale-task-gone=%s stale-status-moved-on=%s\n' \
+    "$([ "$dry" = 1 ] && echo 'dry-run: ')" "$found" "$new" "$dup" "$gone" "$moved"
+}
+
+dq_stuck() {  # <id>
+  dq_say "[$(dq_tag "$1")] decision stuck after $(dq_get "$1" attempts) attempts: $(dq_get "$1" origin) $(dq_get "$1" note)" >/dev/null 2>&1 && dq_set "$1" state stuck
+}
+
+active_count() {  # [dry: 1 leaves stuck records alone]
+  local id n=0 cid
+  for id in $(dq_ids dispatched); do
+    cid=$(dq_get "$id" crewmate)
+    if [ -f "$STATE/$cid.meta" ]; then n=$((n + 1))
+    elif [ "$(dq_get "$id" attempts)" -ge "${FM_DQ_ATTEMPTS:-3}" ]; then [ "${1:-0}" = 1 ] || dq_stuck "$id"
+    else dq_set "$id" state queued; fi
+  done
+  printf '%s' "$n"
+}
+
+write_brief() {  # <crewmate> <id>
+  local cid=$1 id=$2 intent spec tag
+  tag=$(dq_tag "$id")
+  intent="A second mate or crewmate (origin $(dq_get "$id" origin)) opened a decision that is still unanswered, key $(dq_get "$id" key). The owner has to answer it. It must not sit in the main chat."
+  spec="Handle this one decision. Task record id: $id. Reply tag: $tag. Held line: $(dq_get "$id" verb): $(dq_get "$id" note)
+1. Read state/$(dq_get "$id" origin).status and data/$(dq_get "$id" origin)/ for context. Write a short question with 2-4 options and your recommendation.
+2. Send it: $SCRIPT_DIR/fm-decision-queue.sh ask $id '<question, options, recommendation>'. The text carries the tag $tag. Never write a phone number anywhere.
+3. Wait: $SCRIPT_DIR/fm-decision-queue.sh await $id. Exit 3 means no reply: ask once more, then append paused to your status file and stop.
+4. Relay: $SCRIPT_DIR/fm-send.sh $(dq_get "$id" origin) --resolve-key $(dq_get "$id" key) '<the owner answer, verbatim>'.
+5. Close: $SCRIPT_DIR/fm-decision-queue.sh close $id answered. Write the answer in one line to your report, then append done to your status file."
+  "${FM_DQ_BRIEF:-$SCRIPT_DIR/fm-brief.sh}" "$cid" firstmate --scout >/dev/null || return 1
+  awk -v intent="$intent" -v spec="$spec" '$0 == "{TASK}" { print intent; next } $0 == "{FIRSTMATE_SPEC}" { print spec; next } { print }' \
+    "$DATA/$cid/brief.md" > "$DATA/$cid/brief.md.tmp" && mv -f "$DATA/$cid/brief.md.tmp" "$DATA/$cid/brief.md"
+}
+
+cmd_dispatch() {
+  local dry=0 max=${FM_DQ_MAX:-3} active slots id origin key cid over='' overn=0 stamp now
+  while [ $# -gt 0 ]; do
+    case "$1" in
+      --dry-run) dry=1 ;;
+      --max) max=${2:?--max needs a number}; shift ;;
+      *) die "unknown option $1" ;;
+    esac
+    shift
+  done
+  active=$(active_count "$dry"); slots=$((max - active))
+  for id in $(dq_ids queued); do
+    origin=$(dq_get "$id" origin); key=$(dq_get "$id" key)
+    if ! dq_is_open "$origin" "$key"; then
+      [ "$dry" = 1 ] || { dq_set "$id" state closed; dq_set "$id" close_reason stale; }
+      echo "stale $id"; continue
+    fi
+    if [ "$slots" -le 0 ]; then over="$over $origin"; overn=$((overn + 1)); continue; fi
+    cid=dq-$(dq_tag "$id" | tr '[:upper:]' '[:lower:]')
+    if [ "$dry" = 1 ]; then echo "would spawn $cid for $id"; slots=$((slots - 1)); continue; fi
+    dq_set "$id" attempts $(($(dq_get "$id" attempts) + 1))
+    if write_brief "$cid" "$id" && "${FM_DQ_SPAWN:-$SCRIPT_DIR/fm-spawn.sh}" "$cid" "$FM_HOME" --scout >/dev/null; then
+      dq_set "$id" crewmate "$cid"; dq_set "$id" state dispatched
+      echo "spawned $cid for $id"; slots=$((slots - 1))
+    else
+      echo "spawn failed for $id (attempt $(dq_get "$id" attempts))" >&2
+      [ "$(dq_get "$id" attempts)" -lt "${FM_DQ_ATTEMPTS:-3}" ] || dq_stuck "$id"
+    fi
+  done
+  [ "$overn" -gt 0 ] || return 0
+  echo "overflow $overn"
+  [ "$dry" = 0 ] || return 0
+  now=$(dq_now); stamp="$(dq_dir)/.digest-at"
+  [ "$(( now - $(cat "$stamp" 2>/dev/null || echo 0) ))" -ge "${FM_DQ_DIGEST_INTERVAL:-3600}" ] || return 0
+  dq_say "$overn more decisions wait behind the $max open ones. Mates:$(printf '%s' "$over" | tr ' ' '\n' | sed '/^$/d' | sort -u | head -5 | tr '\n' ' ')" \
+    && printf '%s\n' "$now" > "$stamp"
+}
+
+cmd_ask() {
+  local id=${1:-}; need_id "$id"; shift
+  [ $# -gt 0 ] || die "ask needs the text"
+  dq_say "[$(dq_tag "$id")] $* (reply to this text)" || die "text not sent"
+  dq_set "$id" sent_at "$(dq_now)"
+}
+
+cmd_await() {
+  local id=${1:-} timeout=21600 interval=10 sent tag log deadline reply
+  need_id "$id"; shift
+  while [ $# -gt 0 ]; do
+    case "$1" in --timeout) timeout=$2 ;; --interval) interval=$2 ;; *) die "unknown option $1" ;; esac
+    shift 2
+  done
+  sent=$(dq_get "$id" sent_at); [ -n "$sent" ] || die "ask $id first"
+  tag=$(dq_tag "$id")
+  log=${FM_DQ_REPLY_LOG:-${STATE_DIRECTORY:-$HOME/.local/state/fm-imessage}/routing.jsonl}
+  command -v jq >/dev/null || die "await needs jq"
+  deadline=$(( $(dq_now) + timeout ))
+  while :; do
+    reply=$([ -r "$log" ] && jq -r --argjson s "$((sent * 1000))" --arg t "$tag" \
+      'select(.received != null and ((.received.at // .at) >= $s) and ((.received.text // "") | contains($t))) | (.received.authored // .received.text)' "$log" 2>/dev/null | tail -1)
+    if [ -n "$reply" ]; then printf '%s\n' "$reply" | sed "s/\[$tag\]//"; return 0; fi
+    [ "$(dq_now)" -lt "$deadline" ] || return 3
+    sleep "$interval"
+  done
+}
+
+cmd_close() {
+  need_id "${1:-}"
+  dq_set "$1" state closed; dq_set "$1" closed_at "$(dq_now)"; dq_set "$1" close_reason "${2:-closed}"
+}
+
+cmd_progress() {
+  local mate=${1:-} dir now at line; shift
+  dq_slug_ok "$mate" && [ $# -gt 0 ] || die "progress needs <mate> <note>"
+  dir="$(dq_dir)/progress"; mkdir -p "$dir" || return 1
+  line="$mate: $(printf '%s' "$*" | tr '\n\t' '  ' | cut -c1-160)"
+  [ "$(cat "$dir/$mate.line" 2>/dev/null)" != "$line" ] || return 0
+  now=$(dq_now); at=$(cat "$dir/$mate.at" 2>/dev/null || echo 0)
+  [ $((now - at)) -ge "${FM_DQ_PROGRESS_INTERVAL:-600}" ] || return 0
+  dq_say "$line" || return 1
+  printf '%s\n' "$line" > "$dir/$mate.line"; printf '%s\n' "$now" > "$dir/$mate.at"
+}
+
+cmd=${1:-}; [ $# -eq 0 ] || shift
+case "$cmd" in
+  enqueue) [ $# -ge 4 ] || die "enqueue needs <origin> <key> <verb> <note>"
+           o=$1 k=$2 v=$3; shift 3; dq_enqueue "$o" "$k" "$v" "$*" ;;
+  import) cmd_import "$@" ;;
+  dispatch) cmd_dispatch "$@" ;;
+  list) dq_ids "${1:-queued}" ;;
+  ask) cmd_ask "$@" ;;
+  await) cmd_await "$@" ;;
+  close) cmd_close "$@" ;;
+  progress) cmd_progress "$@" ;;
+  ''|-h|--help|help) usage ;;
+  *) die "unknown command $cmd" ;;
+esac
