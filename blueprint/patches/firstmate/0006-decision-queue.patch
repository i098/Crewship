+#!/usr/bin/env bash
+# fm-decision-queue-lib.sh - durable queue for needs-decision and blocked lines.
+#
+# One record file per decision under $STATE/decision-queue/, named
+# <origin>+<key>.rec ("+" is outside both slugs, so the pair is unambiguous).
+# A record is key=value lines; state is queued, dispatched, closed, or stuck.
+# Every write goes to a temp file in the same directory and moves into place.
+# The queue is on only where config/decision-queue exists.
+#
+# Needs FM_HOME and STATE. fm-classify-lib.sh must be sourced for the status folds.
+
+dq_enabled() { [ -e "${CONFIG:-$FM_HOME/config}/decision-queue" ]; }
+dq_dir() { printf '%s/decision-queue' "$STATE"; }
+
+dq_slug_ok() {
+  case "$1" in ''|*[!A-Za-z0-9._-]*) return 1 ;; esac
+}
+
+dq_id() {  # <origin> <key>
+  dq_slug_ok "$1" && dq_slug_ok "$2" || return 1
+  printf '%s+%s' "$1" "$2"
+}
+
+dq_path() { printf '%s/%s.rec' "$(dq_dir)" "$1"; }
+
+# Short owner-facing tag D<6 hex> that a text carries and a reply quotes.
+dq_tag() {
+  local n
+  n=$(printf '%s' "$1" | cksum | awk '{print $1}')
+  printf 'D%06x' $((n % 16777216))
+}
+
+dq_get() {  # <id> <field>
+  sed -n "s/^$2=//p" "$(dq_path "$1")" 2>/dev/null | sed -n 1p
+}
+
+# Rewrite one field (or add it) atomically.
+dq_set() {  # <id> <field> <value>
+  local f tmp
+  f=$(dq_path "$1")
+  tmp=$(mktemp "$(dq_dir)/.rec.XXXXXX") || return 1
+  awk -v k="$2" -v v="$3" 'BEGIN { FS = OFS = "=" }
+    $1 == k && !done { print k "=" v; done = 1; next }
+    { print }
+    END { if (!done) print k "=" v }' "$f" > "$tmp" && mv -f "$tmp" "$f" || { rm -f "$tmp"; return 1; }
+}
+
+dq_now() { date +%s; }
+
+# Print new, dup, or requeued. A record with the same origin, key, and note is a dup.
+dq_enqueue() {  # <origin> <key> <verb> <note>
+  local origin=$1 key=$2 verb=$3 note id f tmp existed=0
+  note=$(printf '%s' "$4" | tr '\n\t' '  ' | cut -c1-400)
+  id=$(dq_id "$origin" "$key") || { echo "fm-decision-queue: bad origin or key: $origin $key" >&2; return 1; }
+  mkdir -p "$(dq_dir)" || return 1
+  f=$(dq_path "$id")
+  if [ -f "$f" ]; then
+    existed=1
+    [ "$(dq_get "$id" note)" != "$note" ] || { echo dup; return 0; }
+    [ "$(dq_get "$id" state)" != dispatched ] || { dq_set "$id" note "$note"; echo dup; return 0; }
+  fi
+  tmp=$(mktemp "$(dq_dir)/.rec.XXXXXX") || return 1
+  printf 'origin=%s\nkey=%s\nverb=%s\nnote=%s\nenqueued_at=%s\nstate=queued\nattempts=0\n' \
+    "$origin" "$key" "$verb" "$note" "$(dq_now)" > "$tmp" && mv -f "$tmp" "$f" || { rm -f "$tmp"; return 1; }
+  if [ "$existed" = 1 ]; then echo requeued; else echo new; fi
+}
+
+# 0 when <key> is still an open decision in <origin>'s status log.
+dq_is_open() {  # <origin> <key>
+  status_own_open_decisions "$STATE/$1.status" | awk -F'\t' -v k="$2" '$1 == k { f = 1 } END { exit !f }'
+}
+
+# Print "<id>" for every record in <state>, oldest enqueue first.
+dq_ids() {  # <state>
+  local f
+  for f in "$(dq_dir)"/*.rec; do
+    [ -f "$f" ] || continue
+    [ "$(sed -n 's/^state=//p' "$f" | sed -n 1p)" = "$1" ] || continue
+    printf '%s %s\n' "$(sed -n 's/^enqueued_at=//p' "$f" | sed -n 1p)" "$(basename "$f" .rec)"
+  done | sort -n | awk '{print $2}'
+}
+
+# One-line text to the owner through the front-desk line; never a phone number here.
+dq_say() {  # <text>
+  "${FM_DQ_IMESSAGE:-fm-imessage}" -- "$1"
+}
+
+# The watcher hook for one status file. Prints nothing. Returns 0 only when the
+# file's decisions were all queued, so the caller keeps them out of chat.
+# A done line of a second mate also sends one rate-limited progress text.
+dq_watch_file() {  # <status-file> <decision-owned: 1|0>
+  local f=$1 owned=$2 origin key verb note n=0 bad=0 line
+  dq_enabled || return 1
+  origin=$(basename "$f" .status)
+  if [ "$(_fm_status_kind "$f")" = secondmate ]; then
+    line=$(last_status_line "$f")
+    status_line_verb "$line" verb
+    if [ "$verb" = "done" ]; then
+      ( "${FM_DQ_SELF:-$FM_ROOT/bin/fm-decision-queue.sh}" progress "$origin" "${line#*: }" >/dev/null 2>&1 </dev/null & )
+    fi
+  fi
+  [ "$owned" = 1 ] || return 1
+  while IFS=$'\t' read -r key verb note; do
+    [ -n "$key" ] || continue
+    n=$((n + 1))
+    dq_enqueue "$origin" "$key" "$verb" "$note" >/dev/null || bad=1
+  done <<EOF
+$(status_own_open_decisions "$f")
+EOF
+  [ "$n" -gt 0 ] && [ "$bad" = 0 ]
+}
+
+# The watcher's periodic pickup: at most every FM_DQ_TICK_SECS (60), import and
+# dispatch in a detached run, so a queued decision needs no manual call.
+# One run at a time; a lock older than 10 minutes belongs to a dead run.
+dq_tick() {
+  local marker="$STATE/.decision-queue-tick" lock="$STATE/.decision-queue.lock" now
+  dq_enabled || return 0
+  now=$(dq_now)
+  [ $((now - $(cat "$marker" 2>/dev/null || echo 0))) -ge "${FM_DQ_TICK_SECS:-60}" ] || return 0
+  printf '%s\n' "$now" > "$marker" || return 0
+  [ -z "$(find "$lock" -maxdepth 0 -mmin +10 2>/dev/null)" ] || rmdir "$lock" 2>/dev/null
+  (
+    mkdir "$lock" 2>/dev/null || exit 0
+    trap 'rmdir "$lock"' EXIT
+    "${FM_DQ_SELF:-$FM_ROOT/bin/fm-decision-queue.sh}" import
+    "${FM_DQ_SELF:-$FM_ROOT/bin/fm-decision-queue.sh}" dispatch
+  ) >>"$STATE/decision-queue.log" 2>&1 </dev/null &
+}
