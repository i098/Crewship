+#!/usr/bin/env bash
+# Behavior tests for bin/fm-decision-queue.sh and its watcher hook.
+# Cases drive the real script against a scratch home with stub spawn, brief, and text senders.
+set -u
+
+# shellcheck source=tests/lib.sh
+. "$(dirname "${BASH_SOURCE[0]}")/lib.sh"
+
+TMP_ROOT=$(fm_test_tmproot fm-decision-queue)
+DQ="$ROOT/bin/fm-decision-queue.sh"
+
+# fresh_home <name>: scratch home with stub tools; prints the path.
+fresh_home() {
+  local h="$TMP_ROOT/$1"
+  mkdir -p "$h/state" "$h/config" "$h/data" "$h/stubs"
+  cat > "$h/stubs/say" <<'SH'
+#!/usr/bin/env bash
+[ "$1" = -- ] && shift
+printf '%s\n' "$*" >> "$FM_HOME/texts.log"
+SH
+  cat > "$h/stubs/brief" <<'SH'
+#!/usr/bin/env bash
+mkdir -p "${FM_DATA_OVERRIDE:-$FM_HOME/data}/$1"
+printf '# Task\n{TASK}\n{FIRSTMATE_SPEC}\n' > "${FM_DATA_OVERRIDE:-$FM_HOME/data}/$1/brief.md"
+SH
+  cat > "$h/stubs/spawn" <<'SH'
+#!/usr/bin/env bash
+printf '%s\n' "$1" >> "$FM_HOME/spawned.log"
+: > "$FM_HOME/state/$1.meta"
+SH
+  chmod +x "$h/stubs/"*
+  printf '%s\n' "$h"
+}
+
+# dq <home> <args...>: run the script in that home.
+dq() {
+  local h=$1; shift
+  FM_HOME="$h" FM_STATE_OVERRIDE="$h/state" FM_CONFIG_OVERRIDE="$h/config" FM_DATA_OVERRIDE="$h/data" FM_DQ_IMESSAGE="$h/stubs/say" FM_DQ_BRIEF="$h/stubs/brief" FM_DQ_SPAWN="$h/stubs/spawn" \
+    FM_DQ_REPLY_LOG="$h/routing.jsonl" "$DQ" "$@"
+}
+
+task() {  # <home> <id> <kind> <status line>...
+  local h=$1 id=$2 kind=$3; shift 3
+  printf 'kind=%s\n' "$kind" > "$h/state/$id.meta"
+  printf '%s\n' "$@" > "$h/state/$id.status"
+}
+
+test_enqueue_is_idempotent_and_replaces_a_changed_note() {
+  local h out
+  h=$(fresh_home enqueue)
+  assert_equals "new" "$(dq "$h" enqueue web k1 needs-decision 'pick a or b')" "first enqueue"
+  assert_equals "dup" "$(dq "$h" enqueue web k1 needs-decision 'pick a or b')" "same origin, key, note"
+  assert_equals "requeued" "$(dq "$h" enqueue web k1 needs-decision 'pick c or d')" "same key, new note"
+  assert_equals "1" "$(find "$h/state/decision-queue" -name '*.rec' | wc -l | tr -d ' ')" "one record per origin and key"
+  assert_equals "web+k1" "$(dq "$h" list)" "listed by id"
+  dq "$h" enqueue 'bad origin' k1 blocked x >/dev/null 2>&1 && fail "a bad origin was queued"
+  assert_equals "" "$(find "$h/state/decision-queue" -name '.rec.*')" "no temp file left behind"
+  pass "enqueue de-duplicates by origin and key and refuses unsafe names"
+}
+
+test_import_drops_stale_decisions_and_is_idempotent() {
+  local h out
+  h=$(fresh_home import)
+  task "$h" live ship 'needs-decision [at=100] [key=k1]: pick a or b'
+  task "$h" moved ship 'needs-decision [at=100] [key=k2]: old' 'working [at=200]: carried on'
+  task "$h" shut ship 'blocked [at=100] [key=k3]: stuck' 'resolved [at=150] [key=k3]: fixed'
+  printf 'needs-decision [at=100] [key=k4]: orphan\n' > "$h/state/gone.status"
+  out=$(dq "$h" import --dry-run)
+  assert_contains "$out" "dry-run: open=3 new=1 already-queued=0 stale-task-gone=1 stale-status-moved-on=1" "dry-run counts"
+  assert_absent "$h/state/decision-queue" "dry-run writes nothing"
+  out=$(dq "$h" import)
+  assert_contains "$out" "new=1 already-queued=0" "first import"
+  out=$(dq "$h" import)
+  assert_contains "$out" "new=0 already-queued=1" "second import changes nothing"
+  assert_equals "live+k1" "$(dq "$h" list)" "only the live decision is queued"
+  pass "import queues live decisions once and drops stale ones"
+}
+
+test_dispatch_caps_crewmates_and_batches_the_overflow() {
+  local h n
+  h=$(fresh_home dispatch)
+  for n in 1 2 3 4 5; do
+    task "$h" "m$n" ship "needs-decision [at=$n] [key=k$n]: question $n"
+    dq "$h" enqueue "m$n" "k$n" needs-decision "question $n" >/dev/null
+    sleep 1
+  done
+  dq "$h" dispatch >/dev/null
+  assert_equals "3" "$(wc -l < "$h/spawned.log" | tr -d ' ')" "three crewmates by default"
+  assert_equals "1" "$(wc -l < "$h/texts.log" | tr -d ' ')" "one digest text for the two left over"
+  assert_contains "$(cat "$h/texts.log")" "2 more decisions wait" "digest counts the overflow"
+  assert_contains "$(cat "$h"/data/dq-*/brief.md)" "fm-send.sh m1 --resolve-key k1" "brief tells the crewmate to relay the answer"
+  assert_equals "m1+k1" "$(dq "$h" list dispatched | head -1)" "oldest first"
+  dq "$h" dispatch >/dev/null
+  assert_equals "3" "$(wc -l < "$h/spawned.log" | tr -d ' ')" "a busy cap spawns nothing more"
+  assert_equals "1" "$(wc -l < "$h/texts.log" | tr -d ' ')" "the digest is rate limited"
+  dq "$h" close m1+k1 answered
+  rm "$h/state/$(sed -n 1p "$h/spawned.log").meta"
+  dq "$h" dispatch >/dev/null
+  assert_equals "4" "$(wc -l < "$h/spawned.log" | tr -d ' ')" "a freed slot takes the next record"
+  pass "dispatch caps concurrent crewmates, takes the oldest first, and digests the overflow"
+}
+
+test_dispatch_closes_a_record_that_is_no_longer_open() {
+  local h out
+  h=$(fresh_home stale)
+  task "$h" w ship 'needs-decision [at=1] [key=k1]: q'
+  dq "$h" enqueue w k1 needs-decision q >/dev/null
+  printf 'resolved [at=2] [key=k1]: answered elsewhere\n' >> "$h/state/w.status"
+  out=$(dq "$h" dispatch)
+  assert_contains "$out" "stale w+k1" "reported stale"
+  assert_absent "$h/spawned.log" "no crewmate spawned"
+  assert_equals "" "$(dq "$h" list)" "nothing left queued"
+  pass "dispatch drops a decision that was resolved after it was queued"
+}
+
+test_ask_await_close_round_trip() {
+  local h tag now
+  h=$(fresh_home reply)
+  dq "$h" enqueue w k1 needs-decision q >/dev/null
+  dq "$h" ask w+k1 'Ship A or B? I recommend A.'
+  tag=$(sed -n 's/^\[\(D[0-9a-f]*\)\].*/\1/p' "$h/texts.log")
+  assert_contains "$tag" "D" "the text carries a tag"
+  now=$(($(date +%s) * 1000))
+  printf '%s\n' \
+    "{\"at\":$((now - 60000)),\"received\":{\"at\":$((now - 60000)),\"text\":\"[$tag] too early\"}}" \
+    "{\"at\":$((now + 5)),\"received\":{\"at\":$((now + 5)),\"text\":\"unrelated\"}}" > "$h/routing.jsonl"
+  dq "$h" await w+k1 --timeout 1 --interval 1 >/dev/null; assert_equals "3" "$?" "no tagged reply after the ask times out"
+  printf '%s\n' "{\"at\":$((now + 9)),\"received\":{\"at\":$((now + 9)),\"text\":\"> [$tag] Ship A or B?\\nA please\",\"authored\":\"A please\"}}" >> "$h/routing.jsonl"
+  assert_equals "A please" "$(dq "$h" await w+k1 --timeout 5 --interval 1)" "the tagged reply is relayed"
+  dq "$h" close w+k1 answered
+  assert_equals "w+k1" "$(dq "$h" list closed)" "closed"
+  pass "ask tags the text, await finds only the tagged later reply, close ends the record"
+}
