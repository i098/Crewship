{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/i098/Crewship/schemas/crewship.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "crewship": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "user": {
          "type": "string",
          "pattern": "^[a-z_][a-z0-9_-]{0,31}$"
        },
        "home": {
          "type": "string",
          "pattern": "^/home/[A-Za-z0-9_./-]+$"
        },
        "workspace": {
          "type": "string",
          "pattern": "^/home/[A-Za-z0-9_./-]+$"
        },
        "start_services": {
          "type": "boolean"
        },
        "enable_linger": {
          "type": "boolean"
        },
        "data_dir": {
          "type": "string",
          "pattern": "^(/[A-Za-z0-9_-][A-Za-z0-9_.-]*)*$"
        },
        "profiles": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "agents": {
              "type": "boolean"
            },
            "development": {
              "type": "boolean"
            },
            "firstmate": {
              "type": "boolean"
            },
            "docker": {
              "type": "boolean"
            },
            "tailscale": {
              "type": "boolean"
            },
            "desktop": {
              "type": "boolean"
            },
            "fleet_guards": {
              "type": "boolean"
            },
            "shared_postgres": {
              "type": "boolean"
            },
            "fleet_browsers": {
              "type": "boolean"
            },
            "chat": {
              "type": "boolean"
            }
          },
          "required": [
            "agents",
            "development",
            "firstmate",
            "docker",
            "tailscale",
            "desktop"
          ]
        },
        "herdr": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "theme": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "toast_delivery": {
              "enum": [
                "off",
                "herdr",
                "terminal",
                "system"
              ]
            },
            "agent_panel_sort": {
              "enum": [
                "spaces",
                "priority"
              ]
            },
            "headless_cols": {
              "type": "integer",
              "minimum": 40,
              "maximum": 500
            },
            "headless_rows": {
              "type": "integer",
              "minimum": 10,
              "maximum": 200
            },
            "sidebar_width": {
              "type": "integer",
              "minimum": 1
            },
            "sidebar_max_width": {
              "type": "integer",
              "minimum": 1
            },
            "sidebar_agent_rows": {
              "type": "string",
              "minLength": 1
            },
            "sidebar_space_rows": {
              "type": "string",
              "minLength": 1
            },
            "sidebar_bg": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "theme",
            "toast_delivery",
            "agent_panel_sort",
            "headless_cols",
            "headless_rows"
          ]
        },
        "browser_prune": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "idle_seconds": {
              "type": "integer",
              "minimum": 600,
              "maximum": 604800
            },
            "poll_seconds": {
              "type": "integer",
              "minimum": 60,
              "maximum": 3600
            },
            "max_gap_seconds": {
              "type": "integer",
              "minimum": 120,
              "maximum": 86400
            }
          },
          "required": [
            "enabled",
            "idle_seconds",
            "poll_seconds",
            "max_gap_seconds"
          ]
        },
        "firstmate": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "url": {
              "type": "string",
              "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
            },
            "checklist": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "repo": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
                },
                "path": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*$"
                }
              },
              "required": [
                "repo",
                "path"
              ]
            }
          },
          "required": [
            "url"
          ]
        },
        "mac_ssh": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "host": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9.:-]*$"
            },
            "user": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]*$"
            }
          },
          "required": [
            "host",
            "user"
          ]
        },
        "skills": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "private_source": {
              "type": "string",
              "pattern": "^(?!https?://[^/]*@)(/|https://|ssh://|file://|[A-Za-z0-9_.-]+@[A-Za-z0-9.-]+:)\\S+$"
            },
            "private_ref": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_][A-Za-z0-9_./-]*$"
            }
          },
          "required": [
            "private_source"
          ]
        },
        "imessage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "owner": {
              "type": "string",
              "pattern": "^\\+[1-9][0-9]{6,14}$"
            },
            "owner_name": {
              "type": "string",
              "pattern": "^[^\\n`$\"\\\\%]{1,40}$"
            },
            "desk_model": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_./:-]*$"
            },
            "supervisor_model": {
              "type": "string",
              "pattern": "^([A-Za-z0-9][A-Za-z0-9_./:-]*)?$"
            },
            "transports": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "photon",
                  "bluebubbles"
                ]
              }
            },
            "bluebubbles": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "relays": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "url": {
                        "type": "string",
                        "pattern": "^https?://[^\\s,\"'\\\\?#%]+$"
                      },
                      "password_env": {
                        "type": "string",
                        "pattern": "^[A-Z_][A-Z0-9_]*$"
                      }
                    },
                    "required": [
                      "url"
                    ]
                  }
                },
                "webhook_listen": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9.-]+:[0-9]{1,5}$"
                }
              },
              "required": [
                "relays",
                "webhook_listen"
              ]
            }
          },
          "required": [
            "owner"
          ],
          "if": {
            "properties": {
              "transports": {
                "contains": {
                  "const": "bluebubbles"
                }
              }
            },
            "required": [
              "transports"
            ]
          },
          "then": {
            "required": [
              "bluebubbles"
            ]
          }
        },
        "github_board": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repo": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
            },
            "project": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "repo",
            "project"
          ]
        },
        "board": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "history": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65536
            },
            "cap_mb": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1024
            },
            "max_msg_kb": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1024
            }
          }
        },
        "desktop": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "display": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9
            },
            "novnc_port": {
              "type": "integer",
              "minimum": 1024,
              "maximum": 65535
            },
            "geometry": {
              "type": "string",
              "pattern": "^[1-9][0-9]{2,3}x[1-9][0-9]{2,3}$"
            }
          },
          "required": [
            "display",
            "novnc_port",
            "geometry"
          ]
        },
        "docker": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "init": {
              "type": "boolean"
            },
            "live_restore": {
              "type": "boolean"
            }
          },
          "required": [
            "init",
            "live_restore"
          ]
        },
        "ci_pool": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "data_dir": {
              "type": "string",
              "pattern": "^/[A-Za-z0-9_./-]+$"
            },
            "total_slots": {
              "oneOf": [
                {
                  "const": "auto"
                },
                {
                  "type": "integer",
                  "minimum": 0
                }
              ]
            },
            "job_cpus": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "job_memory_gb": {
              "type": "integer",
              "minimum": 1
            },
            "repos": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "repo": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
                  },
                  "slots": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "labels": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_.-]+$"
                    },
                    "minItems": 1,
                    "uniqueItems": true
                  }
                },
                "required": [
                  "repo",
                  "slots",
                  "labels"
                ]
              }
            }
          },
          "required": [
            "data_dir",
            "repos"
          ]
        },
        "fleet": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "docker_guard": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "stopped_hours": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        },
        "browsers": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "obscura_version": {
              "type": "string",
              "deprecated": true
            },
            "obscura_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$",
              "deprecated": true
            },
            "idle_timeout_min": {
              "type": "integer",
              "minimum": 5
            }
          }
        }
      },
      "required": [
        "user",
        "home",
        "workspace",
        "start_services",
        "enable_linger",
        "profiles",
        "herdr",
        "browser_prune",
        "firstmate",
        "desktop"
      ]
    }
  },
  "required": [
    "schema_version",
    "crewship"
  ]
}
