#!/usr/bin/env python3
"""One password in front of the host's loopback web pages (docs/gateway.md).

cloudflared's Quick Tunnel is the only remote client. The gateway listens on
127.0.0.1 only and refuses any other peer, so a request from off the host
arrives through the tunnel, whose edge sets CF-Connecting-IP. The gateway trusts
that header and never X-Forwarded-For. A local process can forge the header, but
it already reaches every loopback port directly. After the right password, the
visitor's IP address is allowed for ALLOW_HOURS, and a signed cookie admits the
same browser for the same time when its address changes.
/<port>/<path> goes to http://127.0.0.1:<port>/<path>.

  crewship-gateway serve                     run the gateway (crewship-gateway.service)
  crewship-gateway password [--if-missing]   set a new password, print it once, sign everyone out
  crewship-gateway url                       print the tunnel's public URL
  crewship-gateway revoke [IP]               sign out one address, or every address and cookie
"""

import argparse
import base64
import fcntl
import hashlib
import hmac
import html
import http.client
import ipaddress
import json
import os
import re
import secrets
import socket
import sys
import threading
import time
import urllib.parse
import urllib.request
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path

KEY = "CREWSHIP_GATEWAY_PASSWORD_HASH"
COOKIE = "__Host-crewship"
MAX_FAILURES = 5  # wrong passwords from one address before it is locked out
LOCK_SECONDS = 900  # how long the lockout lasts; failures older than this are forgotten
MAX_BODY = 64 << 20
METRICS = os.environ.get("CREWSHIP_TUNNEL_METRICS") or "127.0.0.1:20241"  # cloudflared, for its URL
ALPHABET = "abcdefghjkmnpqrstuvwxyz23456789"  # no 0/o, 1/l/i: easy to type on a phone
HOP = {"connection", "keep-alive", "proxy-authenticate", "proxy-authorization", "te",
       "trailer", "transfer-encoding", "upgrade", "host", "content-length"}


def hash_password(password, salt=None):
    salt = salt or secrets.token_bytes(16)
    digest = hashlib.scrypt(password.encode(), salt=salt, n=2**14, r=8, p=1)
    return "scrypt$" + base64.b64encode(salt).decode() + "$" + base64.b64encode(digest).decode()


def check_password(password, stored):
    """Constant-time compare against a hash_password() value; a malformed hash never matches."""
    try:
        kind, salt, want = stored.split("$")
        got = hash_password(password, base64.b64decode(salt)).split("$")[2]
    except (AttributeError, ValueError):
        return False
    return kind == "scrypt" and hmac.compare_digest(got, want)


def new_password():
    return "-".join("".join(secrets.choice(ALPHABET) for _ in range(5)) for _ in range(4))


class Gate:
    """The auth decisions. `now` is always passed in, so tests control the clock."""

    def __init__(self, secrets_file, state_file, allow_seconds):
        self.secrets_file = Path(secrets_file)
        self.state_file = Path(state_file)
        self.allow = allow_seconds
        self.failures = {}  # ip -> (count, last failure, locked until); memory only

    # --- the hash, kept in the host's secrets file ----------------------------

    def stored_hash(self):
        try:
            lines = self.secrets_file.read_text().splitlines()
        except FileNotFoundError:
            return None
        values = [line.split("=", 1)[1].strip().strip("'\"") for line in lines
                  if line.startswith(KEY + "=")]
        return values[-1] if values else None

    def set_hash(self, value):
        try:
            lines = self.secrets_file.read_text().splitlines()
        except FileNotFoundError:
            lines = []
        lines = [line for line in lines if not line.startswith(KEY + "=")] + [f"{KEY}={value}"]
        temporary = self.secrets_file.with_name(f".{self.secrets_file.name}.{os.getpid()}")
        fd = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w") as stream:
            stream.write("\n".join(lines) + "\n")
        temporary.replace(self.secrets_file)

    # --- allowed addresses, kept on disk so a restart keeps them ----------------

    def update_state(self, change):
        """Read, change and write the state under a lock, so the CLI and the server never race."""
        self.state_file.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
        with open(self.state_file.with_suffix(".lock"), "a") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            state = self.state()
            change(state)
            temporary = self.state_file.with_suffix(".tmp")
            fd = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
            with os.fdopen(fd, "w") as stream:
                json.dump(state, stream)
            temporary.replace(self.state_file)

    def state(self):
        try:
            state = json.loads(self.state_file.read_text())
        except (FileNotFoundError, ValueError):
            state = {}
        return {"allowed": state.get("allowed", {}), "not_before": state.get("not_before", 0)}

    def revoke(self, now, ip=None):
        def change(state):
            if ip:
                state["allowed"].pop(ip, None)
            else:
                state["allowed"], state["not_before"] = {}, int(now * 1000)
        self.update_state(change)

    # --- cookies: issue time in ms, signed with a key derived from the hash ----

    def _sign(self, stored, issued):
        key = hashlib.sha256(b"crewship-gateway-cookie\0" + stored.encode()).digest()
        return hmac.new(key, str(issued).encode(), hashlib.sha256).hexdigest()

    def cookie(self, now):
        issued = int(now * 1000)
        return f"{issued}.{self._sign(self.stored_hash(), issued)}"

    def cookie_valid(self, value, now, state):
        stored = self.stored_hash()
        issued, _, signature = (value or "").partition(".")
        if not stored or not issued.isdigit():
            return False
        issued = int(issued)
        return (state["not_before"] < issued <= now * 1000 < issued + self.allow * 1000
                and hmac.compare_digest(signature, self._sign(stored, issued)))

    # --- decisions ------------------------------------------------------------

    def admitted(self, ip, cookie, now):
        state = self.state()
        return state["allowed"].get(ip, 0) > now or self.cookie_valid(cookie, now, state)

    def locked_for(self, ip, now):
        """Seconds until `ip` may try again; 0 when it is not locked out."""
        return max(0, int(self.failures.get(ip, (0, 0, 0))[2] - now))

    def login(self, ip, password, now):
        """The cookie value on success; None for a wrong password or a locked-out address."""
        if self.locked_for(ip, now):
            return None
        stored = self.stored_hash()
        if stored and check_password(password, stored):
            self.failures.pop(ip, None)
            self.update_state(lambda state: state["allowed"].__setitem__(ip, now + self.allow))
            return self.cookie(now)
        count, last, _ = self.failures.get(ip, (0, 0, 0))
        count = count + 1 if now - last < LOCK_SECONDS else 1
        self.failures[ip] = (count, now, now + LOCK_SECONDS if count >= MAX_FAILURES else 0)
        if len(self.failures) > 10000:  # many addresses: forget the ones that cannot lock out
            self.failures = {k: v for k, v in self.failures.items() if now - v[1] < LOCK_SECONDS}
        return None


def client_ip(headers):
    """The visitor's address as the tunnel reports it; None when the header is absent or bad."""
    try:
        return str(ipaddress.ip_address((headers.get("CF-Connecting-IP") or "").strip()))
    except ValueError:
        return None


def without_cookie(header):
    return "; ".join(p for p in (header or "").split(";") if p.strip() and
                     not p.strip().startswith(COOKIE + "="))


def safe_next(target):
    """A path on this site only: browsers read "//host" and "/\\host" as another site."""
    return target if re.fullmatch(r"/(?![/\\])[^\\\s]*", target) else "/"


def loopback_ports():
    """Ports that something on this host listens on (for the index page)."""
    ports = set()
    for table in ("/proc/net/tcp", "/proc/net/tcp6"):
        try:
            rows = Path(table).read_text().splitlines()[1:]
        except OSError:
            continue
        for row in rows:
            fields = row.split()
            if fields[3] == "0A":  # LISTEN
                port = int(fields[1].rsplit(":", 1)[1], 16)
                if port >= 1024:
                    ports.add(port)
    return sorted(ports)


PAGE = """<!doctype html><html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Crewship</title><style>
:root{{color-scheme:light dark;font-family:system-ui,sans-serif}}
body{{margin:0;min-height:100vh;display:grid;place-items:center;background:Canvas;color:CanvasText}}
main{{width:min(22rem,calc(100vw - 2.5rem))}}
h1{{font-size:1.4rem;margin:0 0 .4rem}} p{{margin:.2rem 0 1rem;opacity:.75}}
input,button{{box-sizing:border-box;width:100%;font:inherit;font-size:1.05rem;padding:.8rem;border-radius:.6rem}}
input{{border:1px solid #8889;background:transparent;color:inherit;margin-bottom:.7rem}}
button{{border:0;background:#2563eb;color:#fff;font-weight:600}}
.note{{color:#dc2626;opacity:1}} ul{{padding:0;list-style:none}}
li a{{display:block;padding:.7rem;border:1px solid #8885;border-radius:.6rem;margin-bottom:.5rem;color:inherit}}
</style></head><body><main>{body}</main></body></html>"""


def login_body(target, note=""):
    note = f'<p class="note" role="alert">{html.escape(note)}</p>' if note else ""
    return f"""<h1>Crewship</h1><p>Enter the host password.</p>{note}
<form method="post" action="/_gateway/login">
<input type="hidden" name="next" value="{html.escape(safe_next(target))}">
<input type="password" name="password" aria-label="Password" placeholder="Password"
 autocomplete="current-password" autocapitalize="off" autocorrect="off" spellcheck="false" autofocus required>
<button type="submit">Sign in</button></form>"""


class Handler(BaseHTTPRequestHandler):
    server_version = "crewship-gateway"
    timeout = 30  # a client that stops sending mid-request loses its thread after 30 s
    ip = None

    def address_string(self):
        return self.ip or "-"

    def page(self, status, body, cookie=None):
        data = PAGE.format(body=body).encode()
        self.send_response(status)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-store")
        self.send_header("X-Frame-Options", "DENY")
        self.send_header("Content-Security-Policy",
                         "default-src 'none'; style-src 'unsafe-inline'; form-action 'self'")
        if cookie is not None:
            self.send_header("Set-Cookie", cookie)
        self.end_headers()
        if self.command != "HEAD":
            self.wfile.write(data)

    def redirect(self, location, cookie=None):
        self.send_response(303)
        self.send_header("Location", location)
        self.send_header("Content-Length", "0")
        if cookie is not None:
            self.send_header("Set-Cookie", cookie)
        self.end_headers()

    def handle_any(self):
        gate, now = self.server.gate, time.time()
        if not ipaddress.ip_address(self.client_address[0]).is_loopback:
            return self.page(403, "<h1>Forbidden</h1><p>Only the tunnel connects here.</p>")
        self.ip = client_ip(self.headers)
        if self.ip is None:
            return self.page(400, "<h1>Bad request</h1><p>No client address from the tunnel.</p>")
        path, _, query = self.path.partition("?")
        if path == "/_gateway/login" and self.command == "POST":
            return self.login(gate, now)
        if path == "/_gateway/logout" and self.command == "POST":
            gate.revoke(now, self.ip)
            return self.page(200, login_body("/", "Signed out."), f"{COOKIE}=; Max-Age=0; Path=/; Secure; HttpOnly; SameSite=Strict")
        cookies = dict(p.strip().partition("=")[::2] for p in self.headers.get("Cookie", "").split(";"))
        if not gate.admitted(self.ip, cookies.get(COOKIE), now):
            return self.page(401, login_body(self.path))
        if path == "/":
            hidden = {self.server.server_address[1], int(METRICS.rsplit(":", 1)[1])}  # not web pages
            links = "".join(f'<li><a href="/{p}/">Port {p}</a></li>' for p in loopback_ports() if p not in hidden)
            return self.page(200, f"""<h1>Crewship</h1><p>Local web pages on this host.</p>
<ul>{links or "<li>Nothing is listening.</li>"}</ul>
<form method="post" action="/_gateway/logout"><button type="submit">Sign out</button></form>""")
        match = re.fullmatch(r"/(\d{4,5})(/.*)?", path)
        if not match or not 1024 <= int(match[1]) <= 65535 or int(match[1]) == self.server.server_address[1]:
            return self.page(404, "<h1>Not found</h1><p>Open a page as /PORT/path.</p>")
        if match[2] is None:
            return self.redirect(f"{path}/" + (f"?{query}" if query else ""))
        rest = match[2] + (f"?{query}" if query else "")
        if self.headers.get("Upgrade"):
            return self.tunnel(int(match[1]), rest)
        return self.proxy(int(match[1]), rest)

    def login(self, gate, now):
        length = int(self.headers.get("Content-Length") or 0)
        form = urllib.parse.parse_qs(self.rfile.read(min(length, 4096)).decode(errors="replace"))
        target = safe_next(form.get("next", ["/"])[0])
        cookie = gate.login(self.ip, form.get("password", [""])[0], now)
        if cookie:
            return self.redirect(target, f"{COOKIE}={cookie}; Max-Age={gate.allow}; Path=/; Secure; HttpOnly; SameSite=Strict")
        wait = gate.locked_for(self.ip, now)
        if wait:
            return self.page(429, login_body(target, f"Too many wrong passwords. Try again in {wait // 60 + 1} minutes."))
        if not gate.stored_hash():
            return self.page(503, login_body(target, "No password is set. Run crewship-gateway password on the host."))
        return self.page(401, login_body(target, "Wrong password."))

    def upstream_headers(self, port):
        headers = {k: v for k, v in self.headers.items() if k.lower() not in HOP and k.lower() != "cookie"}
        if cookie := without_cookie(self.headers.get("Cookie")):
            headers["Cookie"] = cookie
        headers["Host"] = f"127.0.0.1:{port}"
        return headers

    def proxy(self, port, rest):
        if self.headers.get("Transfer-Encoding"):
            return self.page(411, "<h1>Length required</h1>")
        length = int(self.headers.get("Content-Length") or 0)
        if length > MAX_BODY:
            return self.page(413, "<h1>Request too large</h1>")
        body = self.rfile.read(length) if length else None
        connection = http.client.HTTPConnection("127.0.0.1", port, timeout=3600)
        try:
            connection.request(self.command, rest, body, self.upstream_headers(port))
            response = connection.getresponse()
        except OSError:
            return self.page(502, f"<h1>Nothing answers</h1><p>No web page on port {port}.</p>")
        self.send_response(response.status, response.reason)
        for name, value in response.getheaders():
            if name.lower() in HOP - {"content-length"}:
                continue
            if name.lower() == "location":
                value = re.sub(rf"^(https?://(127\.0\.0\.1|localhost):{port})?(?=/(?!/))", f"/{port}", value)
            self.send_header(name, value)
        self.send_header("Connection", "close")
        self.end_headers()
        self.close_connection = True
        while chunk := response.read1(65536):
            self.wfile.write(chunk)
            self.wfile.flush()
        connection.close()

    def tunnel(self, port, rest):
        """Upgraded connections (WebSocket): send the request on, then copy bytes both ways."""
        try:
            upstream = socket.create_connection(("127.0.0.1", port), timeout=10)
        except OSError:
            return self.page(502, f"<h1>Nothing answers</h1><p>No web page on port {port}.</p>")
        headers = self.upstream_headers(port)
        headers.update(Connection="Upgrade", Upgrade=self.headers["Upgrade"])
        head = f"{self.command} {rest} HTTP/1.1\r\n" + "".join(f"{k}: {v}\r\n" for k, v in headers.items())
        upstream.sendall((head + "\r\n").encode("latin-1"))
        upstream.settimeout(None)
        self.connection.settimeout(None)  # an open WebSocket may be idle for long
        self.close_connection = True

        def copy(source, sink):
            try:
                while data := source.recv(65536):
                    sink.sendall(data)
            except OSError:
                pass
            finally:
                for end in (source, sink):
                    try:
                        end.shutdown(socket.SHUT_RDWR)
                    except OSError:
                        pass

        other = threading.Thread(target=copy, args=(upstream, self.connection), daemon=True)
        other.start()
        copy(self.connection, upstream)
        other.join()
        upstream.close()

    do_GET = do_POST = do_PUT = do_PATCH = do_DELETE = do_HEAD = do_OPTIONS = handle_any


def serve(gate, port):
    server = ThreadingHTTPServer(("127.0.0.1", port), Handler)
    server.gate = gate
    print(f"crewship-gateway: listening on 127.0.0.1:{port}", file=sys.stderr, flush=True)
    server.serve_forever()


def main(argv=None):
    port = int(os.environ.get("CREWSHIP_GATEWAY_PORT") or 20240)
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    commands = parser.add_subparsers(dest="command", required=True)
    commands.add_parser("serve")
    password = commands.add_parser("password")
    password.add_argument("--if-missing", action="store_true", help="do nothing when a password is set")
    commands.add_parser("url")
    commands.add_parser("revoke").add_argument("ip", nargs="?")
    args = parser.parse_args(argv)
    gate = Gate(
        os.environ.get("CREWSHIP_SECRETS") or Path.home() / "super.env",
        os.environ.get("CREWSHIP_GATEWAY_STATE") or Path.home() / ".local/state/crewship/gateway.json",
        int(float(os.environ.get("ALLOW_HOURS") or 24) * 3600),
    )
    if args.command == "serve":
        serve(gate, port)
    elif args.command == "password":
        if args.if_missing and gate.stored_hash():
            return 0
        secret = new_password()
        gate.set_hash(hash_password(secret))
        gate.revoke(time.time())
        print(secret)
    elif args.command == "url":
        try:
            with urllib.request.urlopen(f"http://{METRICS}/quicktunnel", timeout=5) as response:
                hostname = json.load(response).get("hostname")
        except (OSError, ValueError):
            hostname = None
        if not hostname:
            print("crewship-gateway: the tunnel has no URL yet; see journalctl --user -u crewship-tunnel", file=sys.stderr)
            return 1
        print(f"https://{hostname}")
    elif args.command == "revoke":
        gate.revoke(time.time(), args.ip)
    return 0


if __name__ == "__main__":
    sys.exit(main())
