#!/bin/sh
# Docker housekeeping for runner-up (docs/runner-up.md#disk).
#   runner-up-maintain image [--ensure]   build the job image from the latest official
#                                         runner image; with --ensure, only when it is missing
#   runner-up-maintain clean              remove what the jobs left on the disk
#   runner-up-maintain guard              stop the coordinators at the pause level of the disk or above,
#                                         start them again below the resume level; also start the units
#                                         recorded by io-pause, one per run, after 2 min of calm IO
#                                         and start a failed coordinator that no pause holds
#   runner-up-maintain io-pause <unit...> stop units for IO pressure and record them for that resume
# Run with the docker shim first in PATH (runner-up-docker), which adds sudo and the slice.
set -eu
image=${RUNNER_UP_IMAGE:-crewship-ci-runner:latest}
lock=${RUNNER_UP_LOCK:-${XDG_RUNTIME_DIR:-/tmp}/runner-up-image.lock}

have_image() { docker image inspect "$image" >/dev/null 2>&1; }

case "${1-}" in
image)
  [ "${2-}" = --ensure ] && have_image && exit 0
  : "${RUNNER_UP_DOCKERFILE:?}"
  exec 9>"$lock"
  flock 9
  # Another start may have built it while this one waited for the lock.
  [ "${2-}" = --ensure ] && have_image && exit 0
  # --rm and --force-rm drop the build's intermediate containers, success or not.
  docker build --pull --quiet --rm --force-rm --build-arg "REFRESH=$(date +%F)" --tag "$image" - \
    <"$RUNNER_UP_DOCKERFILE" >/dev/null
  # The untagged layers of the previous build; images that a container uses stay.
  docker image prune --force >/dev/null ;;
clean)
  # Only stopped containers of runner-up's places: `docker run --rm` removes them at the end of a job,
  # so one that is left here belongs to a place that crashed.
  # Each step runs on its own, with a time limit: a prune that fails (another prune runs) or hangs on a
  # busy disk must not skip the others, or the build cache grows past its cap. The unit still fails.
  limit=${RUNNER_UP_PRUNE_TIMEOUT:-280}
  failed=0
  prune() { timeout "$limit" docker "$@" >/dev/null || failed=1; }
  prune container prune --force --filter label=runner-up.place --filter until=1h
  prune image prune --force
  prune builder prune --force --keep-storage "${RUNNER_UP_DISK_MAX_GB:-50}GB"
  exit "$failed" ;;
guard)
  # Stopping a coordinator only stops new pickup: KillMode=process leaves running jobs alone.
  # Below the resume level the disk rule starts the coordinators it stopped; the heal below starts a failed one. A unit stopped by hand stays stopped.
  path=${RUNNER_UP_GUARD_PATH:-/}
  pause=${RUNNER_UP_PAUSE_PCT:-88}
  resume=${RUNNER_UP_RESUME_PCT:-85}
  state=${RUNNER_UP_GUARD_STATE:-${XDG_RUNTIME_DIR:-/tmp}/runner-up-guard.paused}
  used=$(df --output=pcent "$path" | tail -n 1 | tr -dc 0-9)
  if [ "$used" -ge "$pause" ]; then
    for i in ${RUNNER_UP_INSTANCES-}; do
      systemctl --user is-active --quiet "runner-up@$i.service" || continue
      systemctl --user stop "runner-up@$i.service" && echo "$i" >> "$state"
    done
  elif [ "$used" -lt "$resume" ] && [ -s "$state" ]; then
    while read -r i; do systemctl --user start "runner-up@$i.service"; done < "$state"
    rm -f "$state"
  fi
  # IO resume: /proc/pressure/io "full avg60" below the level for the whole window, then one unit per run.
  # The disk rule owns a unit it stopped: no unit the disk rule stopped starts while the disk is at the resume level or above.
  io_state=${RUNNER_UP_IO_STATE:-${XDG_RUNTIME_DIR:-/tmp}/runner-up-io.paused}
  io_calm=$io_state.calm
  io_hot=$io_state.hot
  now=${RUNNER_UP_NOW:-$(date +%s)}
  avg=$(awk '$1 == "full" { sub("avg60=", "", $3); print $3 }' "${RUNNER_UP_PRESSURE_FILE:-/proc/pressure/io}" 2>/dev/null) || avg=
  io_above() { [ -n "$avg" ] && awk -v a="$avg" -v m="${RUNNER_UP_IO_PCT:-40}" 'BEGIN { exit !(a > m) }'; }
  io_below() { [ -n "$avg" ] && awk -v a="$avg" -v m="${RUNNER_UP_IO_PCT:-40}" 'BEGIN { exit !(a < m) }'; }
  # IO resume: below the level for the whole window, then one unit per run.
  # The disk rule owns a unit it stopped: no unit the disk rule stopped starts while the disk is at the resume level or above.
  if [ -s "$io_state" ] && [ "$used" -lt "$resume" ]; then
    if io_below; then
      [ -s "$io_calm" ] || echo "$now" > "$io_calm"
      if [ $((now - $(cat "$io_calm"))) -ge "${RUNNER_UP_IO_CALM_SECS:-120}" ]; then
        read -r unit < "$io_state"
        if systemctl --user start "$unit"; then
          grep -vxF "$unit" "$io_state" > "$io_state.new" || true
          mv "$io_state.new" "$io_state"
          [ -s "$io_state" ] || rm -f "$io_calm"
        fi
      fi
    else
      rm -f "$io_calm"
    fi
  fi
  # IO pause: above the level for the whole window, then the newest running heavy coordinator, one per window.
  # Jobs that run keep running; the unit comes back through the IO resume above.
  if io_above; then
    [ -s "$io_hot" ] || echo "$now" > "$io_hot"
    if [ $((now - $(cat "$io_hot"))) -ge "${RUNNER_UP_IO_HOT_SECS:-180}" ]; then
      newest=
      newest_at=-1
      for i in ${RUNNER_UP_IO_HEAVY-}; do
        u=runner-up@$i.service
        systemctl --user is-active --quiet "$u" || continue
        at=$(systemctl --user show -p ActiveEnterTimestampMonotonic --value "$u" | tr -dc 0-9)
        if [ "${at:-0}" -gt "$newest_at" ]; then newest=$u; newest_at=${at:-0}; fi
      done
      [ -z "$newest" ] || "$0" io-pause "$newest"
      rm -f "$io_hot"
    fi
  else
    rm -f "$io_hot"
  fi
  # Heal: a coordinator in the failed state that neither the disk rule nor the IO rule holds starts again; an inactive one that a person stopped stays stopped.
  # Nothing starts at the pause level of the disk, nor while the IO pressure is high for a unit the IO rule may pause.
  if [ "$used" -lt "$pause" ]; then
    for i in ${RUNNER_UP_INSTANCES-}; do
      u=runner-up@$i.service
      systemctl --user is-failed --quiet "$u" || continue
      grep -qxF "$i" "$state" 2>/dev/null && continue
      grep -qxF "$u" "$io_state" 2>/dev/null && continue
      case " ${RUNNER_UP_IO_HEAVY-} " in *" $i "*) ! io_above || continue ;; esac
      systemctl --user start "$u" || true
    done
  fi
  # A stopped place container holds its job's target directory in its layer; prune never removes a running one.
  timeout "${RUNNER_UP_GUARD_PRUNE_TIMEOUT:-40}" docker container prune --force --filter label=runner-up.place >/dev/null || true ;;
io-pause)
  shift
  [ "$#" -gt 0 ] || { echo "usage: runner-up-maintain io-pause <unit...>" >&2; exit 2; }
  io_state=${RUNNER_UP_IO_STATE:-${XDG_RUNTIME_DIR:-/tmp}/runner-up-io.paused}
  for u in "$@"; do
    systemctl --user stop "$u" || continue
    grep -qxF "$u" "$io_state" 2>/dev/null || echo "$u" >> "$io_state"
  done
  rm -f "$io_state.calm" ;;
*)
  echo "usage: runner-up-maintain image [--ensure] | clean | guard | io-pause <unit...>" >&2
  exit 2 ;;
esac
