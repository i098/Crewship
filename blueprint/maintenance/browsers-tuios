#!/bin/sh
# A tuios session of its own, "browsers", showing every headed (live) and
# headless (screenshot) browser through browser-view (docs/herdr.md#browser-view).
# Idempotent and never destructive: a missing session is created, a session
# without its viewer window (the viewer quit or crashed) gets the viewer back,
# and no session is ever killed or recreated.
# Usage: browsers-tuios [--no-attach]   switch with: tuios attach browsers
set -eu
session=browsers
if ! tuios ls --json | jq -e --arg s "$session" 'any(.[]; .name == $s)' >/dev/null; then
    tuios new "$session" --detach >/dev/null
    first=$(tuios list-windows -s "$session" --json | jq -r '.windows[0].window_id')
fi
if ! tuios list-windows -s "$session" --json | jq -e --arg s "$session" 'any(.windows[]; .custom_name == $s)' >/dev/null; then
    tuios new-window "$session" -s "$session" --no-focus -- browser-view >/dev/null
    # The new session's first window is a bare shell; drop it once the viewer is open.
    [ -z "${first:-}" ] || tuios close-window "$first" -s "$session" >/dev/null
fi
[ "${1:-}" = --no-attach ] || exec tuios attach "$session"
