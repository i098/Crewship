#!/bin/sh
# The `docker` that runner-up's service finds first in PATH (docs/runner-up.md#caps).
# runner-up runs a job with a plain `docker run`, which puts the container in system.slice
# with no process limit. This puts every job container and image build in the capped slice
# and limits the processes of a job. An account outside the docker group uses sudo.
set -eu
docker=${RUNNER_UP_DOCKER:-/usr/bin/docker}
slice=${RUNNER_UP_SLICE:-runnerup.slice}
[ -w "${RUNNER_UP_DOCKER_SOCK:-/var/run/docker.sock}" ] || docker="sudo -n $docker"
case "${1-}" in
run)
  shift
  cache=
  if [ -n "${RUNNER_UP_SHARED_CACHE-}" ]; then
    # The build cache every job of the host shares (docs/runner-up.md#shared-build-cache): the
    # compile cache, the cargo registry, the package stores, and cargo's lock files so the lock holds across jobs.
    # Never a shared target directory: a job builds in its own container.
    d=$RUNNER_UP_SHARED_CACHE
    mkdir -p "$d/cargo-registry" "$d/cargo-git" "$d/sccache" "$d/bun" "$d/npm" "$d/pnpm-store"
    touch "$d/cargo-lock" "$d/cargo-lock-mutate"
    chmod 0777 "$d/cargo-registry" "$d/cargo-git" "$d/sccache" "$d/bun" "$d/npm" "$d/pnpm-store"
    chmod 0666 "$d/cargo-lock" "$d/cargo-lock-mutate"
    cache="-v $d/cargo-registry:/home/runner/.cargo/registry -v $d/cargo-git:/home/runner/.cargo/git
      -v $d/cargo-lock:/home/runner/.cargo/.package-cache -v $d/cargo-lock-mutate:/home/runner/.cargo/.package-cache-mutate
      -v $d/bun:/home/runner/.cache/bun -v $d/npm:/home/runner/.cache/npm -v $d/pnpm-store:/home/runner/.cache/pnpm-store
      -v $d/sccache:/sccache -e RUSTC_WRAPPER=sccache -e SCCACHE_DIR=/sccache
      -e SCCACHE_CACHE_SIZE=${RUNNER_UP_CACHE_MAX_GB:-150}G -e CARGO_INCREMENTAL=0
      -e BUN_INSTALL_CACHE_DIR=/home/runner/.cache/bun -e npm_config_cache=/home/runner/.cache/npm
      -e npm_config_store_dir=/home/runner/.cache/pnpm-store"
  fi
  # A job sees every CPU of the host, so cargo would start one rustc and one link for each of them
  # while --cpus holds the job to its own share. A job's own CARGO_BUILD_JOBS still wins.
  # mold sizes its thread pool from the CPUs of the host, not from --cpus, so it gets the same cap
  # unless the job sets RUSTFLAGS or CARGO_ENCODED_RUSTFLAGS itself.
  jobs=
  if [ -n "${RUNNER_UP_JOB_CPUS-}" ]; then
    jobs="-e CARGO_BUILD_JOBS=$RUNNER_UP_JOB_CPUS"
    case "$*" in
    *RUSTFLAGS* | *--env-file*) ;;
    *) set -- -e "RUSTFLAGS=-C link-arg=-Wl,--threads=$RUNNER_UP_JOB_CPUS" "$@" ;;
    esac
  fi
  # shellcheck disable=SC2086 # $docker is a command and its arguments; $cache and $jobs hold no spaces inside a word
  exec $docker run --cgroup-parent "$slice" --pids-limit 8192 $jobs $cache "$@" ;;
build)
  shift
  # shellcheck disable=SC2086
  exec $docker build --cgroup-parent "$slice" "$@" ;;
esac
# shellcheck disable=SC2086
exec $docker "$@"
