{
  // Dev Container for the Crewship worker image.
  //
  // Same provisioned filesystem as compose and CI: an isolated non-root container with
  // the latest, checksum-verified agent/development toolchain (the three omp
  // marketplace plugins are the one unverified exception) already converged by
  // `./ship.sh launch --config blueprint/containers/crewship.container.yml`.
  //
  // Not provided, by design: systemd, user-manager linger, SSH server, Tailscale
  // and the XFCE/TigerVNC/noVNC desktop. Those are native host capabilities
  // provisioned by blueprint/ansible/**.
  "name": "Crewship worker",
  "build": {
    "context": "..",
    "dockerfile": "../Dockerfile",
    // Dev Containers inspects the base image; scratch cannot be pulled.
    "target": "builder",
    "args": {
      "CREWSHIP_USER": "coder",
      "CREWSHIP_UID": "1000",
      "CREWSHIP_GID": "1000",
      "CREWSHIP_HOME": "/home/coder",
      "CREWSHIP_WORKSPACE": "/home/coder/Dev"
    }
  },
  "containerUser": "coder",
  "remoteUser": "coder",
  "updateRemoteUserUID": false,
  "overrideCommand": true,
  "init": true,

  // A named volume never exposes Git/Docker-ignored host checkout files.
  // Clone projects here after authenticating inside the container. The filtered
  // Crewship source snapshot remains available at /opt/crewship.
  "workspaceMount": "source=crewship-dev-workspace,target=/home/coder/Dev,type=volume",
  "workspaceFolder": "/home/coder/Dev",
  "mounts": [],

  // Bounded resources; never --privileged, --pid=host or --network=host.
  "runArgs": [
    "--memory=6g",
    "--memory-swap=6g",
    "--cpus=4",
    "--pids-limit=4096",
    "--shm-size=512m",
    "--cap-drop=NET_RAW"
  ],

  "containerEnv": {
    "CREWSHIP_ROOT": "/opt/crewship",
    "CREWSHIP_CONFIG": "/opt/crewship/blueprint/containers/crewship.container.yml"
  },

  // Version probes only: no agent login, no first-run profile creation, no
  // service start. Run tests/container-smoke.sh for the full behavior smoke.
  "postCreateCommand": "herdr --version && node --version && bun --version && uv --version",

  "features": {}
}
