{{ ansible_managed | comment }}
# Crew board (docs/board.md): host-local, in-memory message board for agents.
# History lives only in memory; a restart drops it.
# %t/crewboard.sock is also the default socket of every crewboard client.
{% set cap_mb = crewship_cfg.board.cap_mb | default(64) %}

[Unit]
Description=Crew board - agent message board on %t/crewboard.sock (Crewship managed)

[Service]
Type=simple
ExecStart={{ crewship_local_bin }}/crewboard serve --socket %t/crewboard.sock --history {{ crewship_cfg.board.history | default(256) }} --cap-bytes {{ cap_mb * 1048576 }} --max-msg {{ (crewship_cfg.board.max_msg_kb | default(64)) * 1024 }}
ExecStopPost=/bin/rm -f %t/crewboard.sock
Restart=always
RestartSec=2
# The payload cap plus 64M for the runtime.
MemoryMax={{ cap_mb + 64 }}M
Nice=2

[Install]
WantedBy=default.target
