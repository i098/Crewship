{{ ansible_managed | comment }}
# Two-way iMessage between the owner and Firstmate over a Photon Spectrum line or
# self-hosted BlueBubbles relays (docs/imessage.md). The Photon project id and
# secret, or each relay's password, come from the host's secret store,
# ~/super.env, at start; no credential is in this unit.

[Unit]
Description=iMessage bridge between the owner and Firstmate (Crewship managed)
After=network-online.target

[Service]
WorkingDirectory={{ crewship_imessage_dir }}
# omp (the front desk) starts with "#!/usr/bin/env bun", and bun lives in ~/.local/bin.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment="FM_HOME={{ crewship_firstmate_dir }}"
Environment="FM_IMESSAGE_OWNER={{ crewship_cfg.imessage.owner }}"
Environment="FM_IMESSAGE_DESK_MODEL={{ crewship_imessage_desk_model }}"
Environment="FM_IMESSAGE_SUPERVISOR_MODEL={{ crewship_imessage_supervisor_model }}"
Environment="FM_IMESSAGE_OWNER_NAME={{ crewship_imessage_owner_name }}"
{% set imessage_transports = crewship_cfg.imessage.transports | default(['photon']) %}
# The transports in order: the first one sends, the next ones are fallbacks.
Environment="FM_IMESSAGE_TRANSPORTS={{ imessage_transports | join(' ') }}"
{% if 'bluebubbles' in imessage_transports %}
# Each relay is "url,VARIABLE": VARIABLE names its password in ~/super.env.
Environment="FM_BLUEBUBBLES_RELAYS={% for relay in crewship_cfg.imessage.bluebubbles.relays %}{{ relay.url }},{{ relay.password_env | default('BLUEBUBBLES_PASSWORD') }}{{ '' if loop.last else ' ' }}{% endfor %}"
Environment="FM_BLUEBUBBLES_WEBHOOK={{ crewship_cfg.imessage.bluebubbles.webhook_listen }}"
{% endif %}
EnvironmentFile=%h/super.env
# ~/.local/state/fm-imessage: the latest text, attachments, the outbox, the downloads to retry, the desk's memory
# and its empty cwd.
StateDirectory=fm-imessage
StateDirectoryMode=0700
UMask=0077
ExecStart={{ crewship_local_bin }}/bun bridge.ts
KillMode=mixed
TimeoutStopSec=10
Restart=always
RestartSec=15

[Install]
WantedBy=default.target
