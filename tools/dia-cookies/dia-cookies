#!/usr/bin/env python3
"""dia-cookies: per-profile cookie export of the Mac's Dia browser.

How it reads: Dia runs with --remote-debugging-port=9222 (kept by the Mac's local.dia-debug agent). The CDP browser
endpoint only serves the default profile's jar, so the Mac side attaches to one open tab per profile and calls
Network.getAllCookies there (that returns the tab's own profile jar, already decrypted by Dia). Each jar is matched to
a Dia profile by comparing (domain, name, path) with that profile's on-disk Cookies DB (metadata columns only).
A profile with no open tab cannot be read: its previous export is kept and reported as stale.
The keychain route (decrypting the DB with "Dia Safe Storage") does not work over ssh: the login keychain is locked there.

Storage, all mode 0600 in 0700 dirs, nothing ever printed except by `get`:
  ~/.local/share/dia-cookies/<profile>/cookies.enc   Fernet-encrypted JSON list of cookies
  ~/.local/share/dia-cookies/<profile>/meta.json     counts and times, never values
  ~/.config/dia-cookies/fernet.key                   at-rest key
"""

import argparse
import json
import os
import subprocess
import sys
import time
from pathlib import Path

from cryptography.fernet import Fernet

HOST = os.environ.get("DIA_COOKIES_HOST", "mac")
STORE = Path(os.environ.get("DIA_COOKIES_DIR", Path.home() / ".local/share/dia-cookies"))
KEYFILE = Path.home() / ".config/dia-cookies/fernet.key"
EXIT_STALE = 3  # some profile had no open tab; every other failure exits 1

# Runs on the Mac under python3 (3.9, stdlib + the `websocket` module the Mac already has). Prints one JSON object.
MAC_SCRIPT = r"""
import json, os, sqlite3, urllib.request, websocket
ROOT = os.path.expanduser("~/Library/Application Support/Dia/User Data")
PORT = 9222
def get(p): return json.load(urllib.request.urlopen(f"http://127.0.0.1:{PORT}{p}", timeout=10))
def rpc(ws, i, method, params=None):
    ws.send(json.dumps({"id": i, "method": method, "params": params or {}}))
    while True:
        r = json.loads(ws.recv())
        if r.get("id") == i: return r
state = json.load(open(ROOT + "/Local State"))
names = {d: i.get("name") or d for d, i in state["profile"]["info_cache"].items()}
# on-disk (domain, name, path) per profile: unencrypted columns only
disk = {}
for d in names:
    for rel in ("Network/Cookies", "Cookies"):
        f = f"{ROOT}/{d}/{rel}"
        if not os.path.isfile(f): continue
        db = sqlite3.connect(f"file:{f}?mode=ro&immutable=1", uri=True)  # metadata columns only; immutable skips Dia's lock/journal
        disk[d] = {(h, n, p) for h, n, p in db.execute("select host_key,name,path from cookies")}
        db.close()
        break
b = websocket.create_connection(get("/json/version")["webSocketDebuggerUrl"], timeout=20)
ctx = {t["targetId"]: t.get("browserContextId") for t in rpc(b, 1, "Target.getTargets")["result"]["targetInfos"]}
jars = {}
for t in get("/json/list"):
    c = ctx.get(t["id"])
    if t["type"] != "page" or not c or c in jars or not t.get("webSocketDebuggerUrl"): continue
    try:
        ws = websocket.create_connection(t["webSocketDebuggerUrl"], timeout=20)
        jars[c] = rpc(ws, 1, "Network.getAllCookies")["result"]["cookies"]
        ws.close()
    except Exception:
        pass
def keyset(cookies): return {(c["domain"], c["name"], c["path"]) for c in cookies}
scores = sorted(((len(keyset(jar) & disk[d]) / max(len(jar), 1), c, d) for c, jar in jars.items() for d in disk), reverse=True)
out, used_c, used_d = {}, set(), set()
for s, c, d in scores:
    if s < 0.5 or c in used_c or d in used_d: continue
    used_c.add(c); used_d.add(d)
    out[d] = {"name": names[d], "cookies": [
        {"name": k["name"], "value": k["value"], "domain": k["domain"], "path": k["path"],
         "expires": int(k["expires"]) if k.get("expires", -1) > 0 else -1,
         "secure": k["secure"], "httpOnly": k["httpOnly"], "sameSite": k.get("sameSite")} for k in jars[c]]}
print(json.dumps({"profiles": out, "unread": {d: names[d] for d in names if d not in out}}))
"""


def fernet():
    if not KEYFILE.exists():
        KEYFILE.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
        fd = os.open(KEYFILE, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        with os.fdopen(fd, "wb") as f:
            f.write(Fernet.generate_key())
    return Fernet(KEYFILE.read_bytes())


def write_private(path, data):
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    tmp = path.with_name(path.name + ".tmp")
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "wb") as f:
        f.write(data)
    os.replace(tmp, path)


def slug(name):
    return "".join(c if c.isalnum() else "-" for c in name.lower()).strip("-")


def cmd_refresh(a):
    r = subprocess.run(
        ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=8", HOST, "python3", "-"],
        input=MAC_SCRIPT.encode(),
        capture_output=True,
        timeout=180,
    )
    if r.returncode:
        sys.exit(
            f"read failed ({r.returncode}): {r.stderr.decode(errors='replace').strip().splitlines()[-1:]}"
        )
    res = json.loads(r.stdout.splitlines()[-1])
    STORE.mkdir(parents=True, exist_ok=True, mode=0o700)
    STORE.chmod(0o700)
    now, rc = int(time.time()), 0
    for d, p in res["profiles"].items():
        s = slug(p["name"])
        if a.profile and s not in a.profile:
            continue
        if not p["cookies"]:  # an empty read must not wipe a good export
            continue
        write_private(
            STORE / s / "cookies.enc", fernet().encrypt(json.dumps(p["cookies"]).encode())
        )
        write_private(
            STORE / s / "meta.json",
            json.dumps(
                {
                    "profile": s,
                    "dia_dir": d,
                    "display_name": p["name"],
                    "refreshed_at": now,
                    "count": len(p["cookies"]),
                    "domains": len({c["domain"].lstrip(".") for c in p["cookies"]}),
                }
            ).encode(),
        )
        print(f"{s}: {len(p['cookies'])} cookies")
    for d, name in res["unread"].items():
        if not a.profile or slug(name) in a.profile:
            print(
                f"{slug(name)}: not readable now (no open tab in that Dia profile); previous export kept",
                file=sys.stderr,
            )
            rc = EXIT_STALE
    return rc


def load(s):
    f = STORE / s / "cookies.enc"
    if not f.exists():
        sys.exit(
            f"no export for profile {s!r}; known: {', '.join(sorted(p.parent.name for p in STORE.glob('*/meta.json')))}"
        )
    return json.loads(fernet().decrypt(f.read_bytes()))


def host_match(cookie_domain, want):
    cd, w = cookie_domain.lstrip(".").lower(), want.lstrip(".").lower()
    return cd == w or w.endswith("." + cd) or cd.endswith("." + w)


def select(s, domains):
    now = time.time()
    return [
        c
        for c in load(s)
        if (c["expires"] < 0 or c["expires"] > now)
        and (not domains or any(host_match(c["domain"], d) for d in domains))
    ]


def cmd_list(a):
    if a.profile:
        for c in sorted(select(a.profile, a.domain), key=lambda c: (c["domain"], c["name"])):
            exp = (
                "session"
                if c["expires"] < 0
                else time.strftime("%Y-%m-%d", time.gmtime(c["expires"]))
            )
            print(
                f"{c['domain']}\t{c['path']}\t{c['name']}\texpires {exp}"
            )  # names only, never values
        return 0
    for f in sorted(STORE.glob("*/meta.json")):
        m = json.loads(f.read_text())
        print(
            f"{m['profile']}\t{m['count']} cookies\t{m['domains']} domains\trefreshed {int((time.time() - m['refreshed_at']) / 60)} min ago\t(Dia '{m['display_name']}')"
        )
    return 0


def fmt(cookies, how):
    if how == "json":
        return json.dumps(cookies, indent=1)
    if how == "header":
        return "; ".join(f"{c['name']}={c['value']}" for c in cookies)
    lines = [
        "# Netscape HTTP Cookie File"
    ]  # netscape, for curl -b and `api-anything login --cookies`
    for c in cookies:
        d = c["domain"]
        lines.append(
            "\t".join(
                [
                    ("#HttpOnly_" if c["httpOnly"] else "") + d,
                    "TRUE" if d.startswith(".") else "FALSE",
                    c["path"],
                    "TRUE" if c["secure"] else "FALSE",
                    str(max(c["expires"], 0)),
                    c["name"],
                    c["value"],
                ]
            )
        )
    return "\n".join(lines)


def cmd_get(a):
    text = fmt(select(a.profile, a.domain), a.format) + "\n"
    if a.output == "-":
        sys.stdout.write(text)
    else:
        write_private(Path(a.output), text.encode())
        print(f"wrote {a.output} (0600)")
    return 0


def main():
    p = argparse.ArgumentParser(prog="dia-cookies", description=__doc__.split("\n")[0])
    sub = p.add_subparsers(dest="cmd", required=True)
    s = sub.add_parser(
        "refresh", help="export cookies from the Mac's Dia (all profiles, or the named ones)"
    )
    s.add_argument("profile", nargs="*")
    s.set_defaults(fn=cmd_refresh)
    s = sub.add_parser(
        "list", help="no args: profiles and freshness; with PROFILE: cookie names, never values"
    )
    s.add_argument("profile", nargs="?")
    s.add_argument("--domain", action="append", default=[])
    s.set_defaults(fn=cmd_list)
    s = sub.add_parser(
        "get", help="write cookies for a profile to a 0600 file (values!); -o - prints them"
    )
    s.add_argument("profile")
    s.add_argument("--domain", action="append", default=[])
    s.add_argument("--format", choices=["json", "netscape", "header"], default="json")
    s.add_argument("-o", "--output", required=True)
    s.set_defaults(fn=cmd_get)
    a = p.parse_args()
    sys.exit(a.fn(a))


if __name__ == "__main__":
    main()
