#!/bin/bash
# Send iMessage to the owner from the Firstmate line (docs/imessage.md).
# Usage: fm-imessage [--reply N | --reply-id ID] [--no-thread] [--key TOPIC] [--] 'text' | fm-imessage [--reply N | --reply-id ID] [--no-thread] --image PATH ['caption']
#        fm-imessage --typing | fm-imessage --react '👍' | fm-imessage --card '<json>'|-|FILE
# Blank-line-separated paragraphs become separate bubbles; a list stays one bubble. Sends are plain by default.
# --reply N threads the first bubble only across later bubbles; --no-thread forces plain even with --reply N.
# --reply-id ID threads to that exact message id, so a newer text cannot move the target; an unknown id sends nothing.
# --image sends a photo (png, jpg or webp, up to 25 MB), then the caption as text bubbles. The bridge downscales a
# photo with a side over 2048 px and checks it by content. Photos go over the Photon line only.
# --typing shows the typing bubble (best effort; timing: docs/imessage.md#what-it-does); --react puts a tapback on his latest text.
# --card sends a card, an app bubble that opens its page in Messages: JSON text, - for stdin, or a file (docs/imessage.md#cards).
# --key TOPIC logs the text under a topic key; the same key with the same content on the same local day is skipped (exit 0, the message says skipped).
# Text and caption pass through the outbound filter (clean.ts: strips tags, ids, raw paths, status prefixes).
# Exit 0 = queued: the bridge sends in order and retries while the upstream is down. Exit non-zero = nothing queued.
# A refused connection or a 503 "stopping" answer means nothing was queued (a rolling deploy handing over,
# docs/imessage.md#rolling-deploys): the request is sent again, up to FM_IMESSAGE_WAIT_S seconds (150), so a handover or a rollback costs no text.
url=http://127.0.0.1:${FM_IMESSAGE_PORT:-8765}
B=(curl -sS --fail-with-body --max-time 60 -H 'X-Firstmate: 1' -H "X-Fm-Sender: ${FM_MATE_ID:-${FM_HOME:-}}")
q=
image=
rn=
rid=
here=$(dirname "$(readlink -f "$0")")
fail() { echo "fm-imessage: $1 (nothing sent)" >&2; exit 2; }
post() { # post CURL_ARGS...: stdin is kept in a file, so a retry sends the same bytes
  local body out err code end=$((SECONDS + ${FM_IMESSAGE_WAIT_S:-150}))
  body=$(mktemp) out=$(mktemp) err=$(mktemp); cat > "$body"
  while :; do
    "${B[@]}" "$@" < "$body" > "$out" 2> "$err"; code=$?
    { [ $code = 7 ] || { [ $code = 22 ] && [ "$(head -c 8 "$out")" = stopping ]; }; } && [ $SECONDS -lt $end ] || break
    sleep 1
  done
  cat "$out"; cat "$err" >&2; rm -f "$body" "$out" "$err"
  return $code
}
while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help) sed -n '2,14p' "$0" | cut -c3-; exit 0 ;;
    --typing) post -X POST "$url/typing" </dev/null; exit ;;
    --react) printf '%s' "${2:?emoji}" | post --data-binary @- "$url/react"; exit ;;
    --card) [ -n "${2:-}" ] || fail "--card needs JSON, - or a file"
            if [ "$2" = - ]; then cat; elif [ -f "$2" ]; then cat -- "$2"; else printf '%s' "$2"; fi | post --data-binary @- "$url/card"; exit ;;
    --reply) case "${2:-}" in [1-9]|10) ;; *) echo "fm-imessage: --reply needs a number from 1 to 10 (nothing sent)" >&2; exit 2 ;; esac
             [ -z "$rid" ] || fail "use either --reply or --reply-id, not both"
             q="${q:+$q&}reply=$2"; rn=1; shift 2 ;;
    --reply-id) [ -n "${2:-}" ] || fail "--reply-id needs a message id"
                [ -z "$rn" ] || fail "use either --reply or --reply-id, not both"
                rid=$(LC_ALL=C; e=; v=$2; for ((i=0; i<${#v}; i++)); do c=${v:i:1}; case $c in [A-Za-z0-9._~-]) e+=$c ;; *) e+=$(printf '%%%02X' "'$c") ;; esac; done; printf %s "$e")
                q="${q:+$q&}reply-id=$rid"; shift 2 ;;
    --key) [ -n "${2:-}" ] || fail "--key needs a topic key"; B+=(-H "X-Fm-Key: $2"); shift 2 ;;
    --no-thread) q="${q:+$q&}no-thread=1"; shift ;;
    --image) [ -n "${2:-}" ] || fail "--image needs a file path"; image=$2; shift 2 ;;
    --) shift; break ;;
    -*) echo "fm-imessage: unknown option $1 (nothing sent)" >&2; exit 2 ;;
    *) break ;;
  esac
done
clean() { # filter stdin; send it unchanged with a warning when bun or clean.ts is missing or fails
  local buf out
  buf=$(cat; echo x); buf=${buf%x}
  if command -v bun >/dev/null && [ -f "$here/clean.ts" ] && out=$(printf '%s' "$buf" | bun "$here/clean.ts" || exit 1; echo x); then
    out=${out%x}; printf '%s' "$out"
  else
    echo "fm-imessage: filter unavailable or failed, sending text unfiltered" >&2; printf '%s' "$buf"
  fi
}
if [ -n "$image" ]; then
  # The bridge checks the content and the size again; these checks only give the quick answer.
  [ -f "$image" ] && [ -r "$image" ] || fail "$image is not a readable file"
  case "${image,,}" in *.png|*.jpg|*.jpeg|*.webp) ;; *) fail "$image is not a png, jpg or webp file" ;; esac
  [ "$(stat -c %s -- "$image")" -le 26214400 ] || fail "$image is over 25 MB"
  p=${image//\\/\\\\}
  p=${p//\"/\\\"}
  cap=$*
  if [ -n "$cap" ]; then cap=$(printf '%s' "$cap" | clean; echo x); cap=${cap%x}; fi
  post -F "image=@\"$p\"" --form-string "caption=$cap" "$url/image${q:+?$q}" </dev/null; exit
fi
{ if [ $# -gt 0 ]; then printf '%s' "$*"; else cat; fi; } | clean | post --data-binary @- "$url/send${q:+?$q}"
